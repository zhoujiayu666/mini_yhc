/**app.wxss**/

/* 全局设计 token */

page {

  --brand-yellow: #FFD100;

  --brand-yellow-light: #FFF8E1;

  --brand-yellow-soft: rgba(255, 209, 0, 0.12);

  --brand-yellow-glow: rgba(255, 209, 0, 0.35);

  --brand-yellow-text: #C89600;

  --page-bg: #FFFFFF;

  --bg-black: #121212;

  --text-primary: #212121;

  --text-secondary: #757575;

  --text-tertiary: #9E9E9E;

  --success-green: #4CAF50;

  --warning-orange: #FF9800;

  --error-red: #F44336;

  --card-bg: #F7F7F8;

  --card-bg-elevated: #FFFFFF;

  --surface-subtle: #EEEEEE;

  --border-color: #E8E8E8;

  --radius-sm: 12rpx;

  --radius-md: 20rpx;

  --radius-lg: 28rpx;

  --radius-xl: 32rpx;

  --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);

  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);

  --shadow-lg: 0 16rpx 40rpx rgba(0, 0, 0, 0.1);



  background-color: var(--page-bg);

  color: var(--text-primary);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;

}



.logo-text {

  font-size: 32rpx;

  font-weight: 600;

  color: var(--text-primary);

}



/* 页面顶部氛围渐变 */

.page-ambient {

  background: linear-gradient(180deg, #FFFBF0 0%, #FFFFFF 360rpx);

  min-height: 100%;

}



/* 通用容器 */

.container {

  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));

  box-sizing: border-box;

}



/* 通用卡片 */

.card {

  background-color: var(--card-bg-elevated);

  border: 1rpx solid var(--border-color);

  border-radius: var(--radius-lg);

  padding: 32rpx;

  margin: 16rpx 32rpx;

  box-shadow: var(--shadow-sm);

}



.card-elevated {

  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF5 100%);

  border: 1rpx solid rgba(255, 209, 0, 0.15);

  box-shadow: var(--shadow-md);

}



/* 通用按钮 */

.btn {

  background-color: var(--card-bg);

  color: var(--text-primary);

  border-radius: var(--radius-md);

  padding: 24rpx 32rpx;

  font-size: 32rpx;

  text-align: center;

  border: 2rpx solid var(--border-color);

  transition: all 0.25s ease;

}



.btn-active {

  background-color: var(--brand-yellow);

  color: var(--bg-black);

  border-color: var(--brand-yellow);

}



/* 统一帮助按钮 */

.help-btn {

  padding: 16rpx 32rpx;

  display: flex;

  align-items: center;

  justify-content: center;

}



.help-btn-icon {

  width: 44rpx;

  height: 44rpx;

  border-radius: 50%;

  border: 2rpx solid var(--border-color);

  background: var(--card-bg);

  display: flex;

  align-items: center;

  justify-content: center;

}



.help-btn-icon:active {

  background: var(--surface-subtle);

}



/* 通用滑块 */

.slider-container {

  display: flex;

  align-items: center;

  padding: 32rpx;

}



.slider-btn {

  width: 64rpx;

  height: 64rpx;

  border-radius: var(--radius-sm);

  background-color: var(--card-bg);

  border: 2rpx solid var(--border-color);

  display: flex;

  align-items: center;

  justify-content: center;

  color: var(--text-primary);

  font-size: 40rpx;

  font-weight: 300;

}



.slider-btn:active {

  background-color: var(--surface-subtle);

}



.slider-wrapper {

  flex: 1;

  margin: 0 24rpx;

}



/* 底部弹窗 sheet */

.sheet-modal {

  position: fixed;

  top: 0;

  left: 0;

  right: 0;

  bottom: 0;

  background-color: rgba(0, 0, 0, 0.5);

  display: flex;

  align-items: flex-end;

  justify-content: center;

  z-index: 1000;

  opacity: 0;

  visibility: hidden;

  transition: opacity 0.3s, visibility 0.3s;

}



.sheet-modal.show {

  opacity: 1;

  visibility: visible;

}



.sheet-content {

  width: 100%;

  max-height: 85vh;

  background-color: var(--page-bg);

  border-radius: var(--radius-xl) var(--radius-xl) 0 0;

  box-shadow: var(--shadow-lg);

  display: flex;

  flex-direction: column;

  overflow: hidden;

  transform: translateY(100%);

  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);

}



.sheet-modal.show .sheet-content {

  transform: translateY(0);

}



.sheet-header {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 32rpx;

  border-bottom: 1rpx solid var(--border-color);

}



.sheet-title {

  font-size: 32rpx;

  font-weight: 600;

  color: var(--text-primary);

}



.sheet-close {

  width: 56rpx;

  height: 56rpx;

  border-radius: 50%;

  background: var(--card-bg);

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 40rpx;

  color: var(--text-secondary);

  line-height: 1;

}



.sheet-body {

  flex: 1;

  overflow-y: auto;

  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));

}



/* 空状态 */

.empty-state {

  padding: 64rpx 32rpx;

  text-align: center;

  display: flex;

  flex-direction: column;

  align-items: center;

}



.empty-state-icon {

  width: 120rpx;

  height: 120rpx;

  border-radius: 50%;

  background: var(--brand-yellow-soft);

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 24rpx;

  font-size: 56rpx;

}



.empty-state-title {

  font-size: 28rpx;

  color: var(--text-primary);

  font-weight: 500;

  margin-bottom: 12rpx;

}



.empty-state-desc {

  font-size: 24rpx;

  color: var(--text-tertiary);

  line-height: 1.6;

}



/* 设置行图标 */

.settings-icon {

  width: 48rpx;

  height: 48rpx;

  border-radius: var(--radius-sm);

  background: var(--brand-yellow-soft);

  display: flex;

  align-items: center;

  justify-content: center;

  margin-right: 20rpx;

  font-size: 26rpx;

  flex-shrink: 0;

}


