/**music-rhythm.wxss**/

page {

  height: 100vh;

  display: flex;

  flex-direction: column;

  background-color: var(--page-bg);

}



.scrollarea {

  flex: 1;

  min-height: 0;

  height: 0;

  padding-bottom: 0;

}



.container {

  padding: 24rpx 20rpx;

}



.logo-container {

  display: flex;

  align-items: center;

  padding-left: 32rpx;

}



.logo-icon {

  width: 48rpx;

  height: 48rpx;

  margin-right: 16rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  background: var(--brand-yellow-soft);

  border-radius: 50%;

}



.logo-icon-text {

  font-size: 28rpx;

  color: var(--brand-yellow-text);

  line-height: 1;

}



.help-q {

  font-size: 28rpx;

  color: var(--text-secondary);

  font-weight: 600;

}



.microphone-section {

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  padding: 48rpx 0 32rpx;

  margin-bottom: 24rpx;

}



.microphone-icon {

  position: relative;

  width: 360rpx;

  height: 360rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  border: 3rpx solid var(--brand-yellow-glow);

  background: radial-gradient(circle, rgba(255, 209, 0, 0.16) 0%, rgba(255, 209, 0, 0.04) 58%, transparent 100%);

  box-shadow: 0 12rpx 40rpx var(--brand-yellow-glow);

  transition: transform 0.25s;

}



.microphone-icon:active {

  transform: scale(0.97);

}



.microphone-icon.listening {

  animation: pulse 2s infinite;

  border-color: transparent;

  background: transparent;

  box-shadow: none;

}



.mic-visual {

  width: 160rpx;

  height: 200rpx;

  position: relative;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: flex-start;

}



.mic-head {

  width: 72rpx;

  height: 108rpx;

  border-radius: 40rpx;

  border: 4rpx solid var(--brand-yellow);

  background-color: rgba(255, 209, 0, 0.16);

  box-sizing: border-box;

}



.mic-stem {

  width: 8rpx;

  height: 40rpx;

  margin-top: 10rpx;

  border-radius: 6rpx;

  background: var(--brand-yellow);

}



.mic-base {

  width: 84rpx;

  height: 8rpx;

  margin-top: 10rpx;

  border-radius: 8rpx;

  background: var(--brand-yellow);

}



.stop-visual {

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  gap: 14rpx;

  z-index: 2;

}



.stop-dot {

  width: 56rpx;

  height: 56rpx;

  border-radius: 12rpx;

  background: var(--error-red);

  box-shadow: 0 0 24rpx rgba(244, 67, 54, 0.5);

}



.stop-text {

  color: var(--brand-yellow-text);

  font-size: 28rpx;

  font-weight: 600;

}



.mic-hint {

  margin-top: 24rpx;

  font-size: 26rpx;

  color: var(--text-secondary);

}



@keyframes pulse {

  0%, 100% { transform: scale(1); opacity: 1; }

  50% { transform: scale(1.04); opacity: 0.85; }

}



.audio-waves {

  position: absolute;

  top: 50%;

  left: 50%;

  transform: translate(-50%, -50%);

  width: 360rpx;

  height: 360rpx;

}



.wave {

  position: absolute;

  top: 50%;

  left: 50%;

  transform: translate(-50%, -50%);

  border: 4rpx solid var(--brand-yellow);

  border-radius: 50%;

  opacity: 0;

}



.wave1 { width: 180rpx; height: 180rpx; animation: wave-animation 2s infinite; }

.wave2 { width: 260rpx; height: 260rpx; animation: wave-animation 2s infinite 0.5s; }

.wave3 { width: 360rpx; height: 360rpx; animation: wave-animation 2s infinite 1s; }



@keyframes wave-animation {

  0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }

  100% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }

}



.spectrum-wrap {

  display: flex;

  align-items: flex-end;

  justify-content: center;

  gap: 8rpx;

  height: 80rpx;

  margin-top: 28rpx;

  padding: 0 32rpx;

}



.spectrum-bar {

  width: 12rpx;

  height: 64rpx;

  border-radius: 6rpx;

  background: linear-gradient(180deg, var(--brand-yellow) 0%, rgba(255, 209, 0, 0.4) 100%);

  transform-origin: bottom center;

  transition: transform 0.08s ease-out;

}



.sensitivity-section {

  margin-bottom: 32rpx;

}



.sensitivity-section.card {

  margin-left: 24rpx;

  margin-right: 24rpx;

  padding: 28rpx 32rpx;

}



.section-header {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 16rpx;

}



.section-title {

  font-size: 28rpx;

  font-weight: 600;

  color: var(--text-primary);

}



.sensitivity-value {

  font-size: 32rpx;

  font-weight: 700;

  color: var(--brand-yellow-text);

}



.sensitivity-presets {

  display: flex;

  gap: 12rpx;

  margin-bottom: 20rpx;

}



.preset-chip {

  flex: 1;

  text-align: center;

  padding: 14rpx 0;

  border-radius: var(--radius-sm);

  font-size: 24rpx;

  color: var(--text-secondary);

  background: var(--card-bg);

  border: 2rpx solid var(--border-color);

  transition: all 0.2s;

}



.preset-chip.active {

  background: var(--brand-yellow-light);

  border-color: var(--brand-yellow);

  color: var(--brand-yellow-text);

  font-weight: 600;

}



.slider-container {

  display: flex;

  align-items: center;

}



.sensitivity-section .slider-container {

  margin-left: -32rpx;

  margin-right: -32rpx;

  padding-left: 16rpx;

  padding-right: 16rpx;

  box-sizing: border-box;

}



.slider-btn {

  width: 56rpx;

  height: 56rpx;

  flex-shrink: 0;

  border-radius: var(--radius-sm);

  background-color: var(--card-bg);

  border: 2rpx solid var(--border-color);

  display: flex;

  align-items: center;

  justify-content: center;

  color: var(--text-primary);

  font-size: 34rpx;

  font-weight: 300;

}



.slider-btn:active {

  background: var(--brand-yellow-light);

}



.slider-wrapper {

  flex: 1;

  min-width: 0;

  margin: 0 10rpx;

}



.slider-track-shell {

  width: 100%;

  height: 32rpx;

  border-radius: 32rpx;

  background-color: var(--surface-subtle);

  padding: 0 6rpx;

  box-sizing: border-box;

  display: flex;

  align-items: center;

}



.track-slider {

  width: 100%;

}



.help-modal-mask {

  position: fixed;

  top: 0;

  left: 0;

  right: 0;

  bottom: 0;

  background: rgba(0, 0, 0, 0.5);

  display: flex;

  justify-content: center;

  align-items: flex-end;

  z-index: 2000;

  padding: 0;

  box-sizing: border-box;

}



.help-modal {

  width: 100%;

  max-width: 100%;

  background: var(--page-bg);

  border-radius: var(--radius-xl) var(--radius-xl) 0 0;

  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));

  box-sizing: border-box;

  box-shadow: var(--shadow-lg);

}



.help-title {

  font-size: 36rpx;

  color: var(--text-primary);

  font-weight: 600;

  margin-bottom: 24rpx;

}



.help-content {

  display: flex;

  flex-direction: column;

  gap: 16rpx;

}



.help-content text {

  font-size: 28rpx;

  line-height: 1.65;

  color: var(--text-secondary);

}



.help-version {

  color: var(--text-tertiary);

  margin-top: 8rpx;

}



.help-confirm {

  margin-top: 32rpx;

  height: 88rpx;

  border-radius: var(--radius-md);

  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);

  color: var(--bg-black);

  font-size: 30rpx;

  font-weight: 600;

  display: flex;

  justify-content: center;

  align-items: center;

  box-shadow: 0 4rpx 16rpx var(--brand-yellow-glow);

}


