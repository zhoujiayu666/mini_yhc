page{background:#f4f4f1;color:#24272c}.editor{padding:28rpx 26rpx 180rpx}.notice{background:#fff1bc;padding:26rpx;border-radius:18rpx;font-weight:600;font-size:28rpx}.notice text{display:block;font-size:23rpx;line-height:1.7;font-weight:400;margin-top:12rpx}.toolbar,.actions,.bottom,.switch-row{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.toolbar{margin:28rpx 0}.toolbar button,.actions button{margin:0}.module-list{margin-bottom:26rpx}.module-row{display:flex;justify-content:space-between;padding:25rpx;background:#fff;border-bottom:1rpx solid #eee;font-size:26rpx}.module-row.active{background:#262b35;color:#fff}.panel{padding:26rpx;background:white;border-radius:20rpx}.panel-title{font-size:30rpx;font-weight:700;margin-bottom:24rpx}.actions{margin-bottom:24rpx}label{display:block;font-size:24rpx;margin:24rpx 0}input,textarea,.input{background:#f5f5f3;padding:20rpx;margin-top:12rpx;border-radius:10rpx;font-size:26rpx;box-sizing:border-box;width:100%}input{height:80rpx}.switch-row{font-size:26rpx}.swatches{display:flex;gap:20rpx;margin-top:20rpx}.swatch{width:50rpx;height:50rpx;border-radius:50%;border:4rpx solid #ddd}.swatch.chosen{border-color:#c29921}.item{padding:24rpx 0;border-top:1rpx solid #e9e9e9;margin-top:28rpx}.bottom{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eee}.bottom button{width:48%;font-size:28rpx}.primary{background:#ffd100}button{font-size:26rpx}
