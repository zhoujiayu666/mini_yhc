page {

  height: 100vh;

  display: flex;

  flex-direction: column;

  background-color: var(--page-bg);

}



.scrollarea {

  flex: 1;

  min-height: 0;

  height: 0;

}



.container {

  padding: 24rpx 32rpx calc(100rpx + env(safe-area-inset-bottom) + 32rpx);

}



.status-card {

  margin: 0 0 14rpx;

  padding: 0;

  background: transparent;

  box-shadow: none;

  border-radius: 0;

  border: none;

}



.status-header {

  display: flex;

  align-items: center;

  justify-content: space-between;

}



.status-indicator {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

}



.status-dot {

  width: 14rpx;

  height: 14rpx;

  border-radius: 50%;

  background-color: var(--text-tertiary);

  margin-right: 10rpx;

}



.status-dot.connected {

  background-color: var(--success-green);

  box-shadow: 0 0 10rpx rgba(76, 175, 80, 0.5);

}



.status-text {

  font-size: 26rpx;

  color: var(--text-primary);

  font-weight: 600;

}



.status-device-inline {

  margin-left: 10rpx;

  max-width: 360rpx;

  font-size: 23rpx;

  color: var(--text-secondary);

}



.status-action {

  padding: 10rpx 20rpx;

  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);

  border-radius: var(--radius-sm);

  box-shadow: 0 4rpx 12rpx var(--brand-yellow-glow);

}



.action-text {

  font-size: 23rpx;

  color: var(--bg-black);

  font-weight: 600;

}



.page-back-entry {

  display: inline-flex;

  align-items: center;

  height: 64rpx;

  margin-bottom: 18rpx;

  padding: 8rpx 16rpx 8rpx 0;

  border-radius: var(--radius-sm);

}



.page-back-entry:active {

  background: var(--brand-yellow-soft);

}



.page-back-arrow {

  color: var(--brand-yellow-text);

  font-size: 48rpx;

  line-height: 1;

  margin-right: 8rpx;

}



.page-back-text {

  color: var(--brand-yellow-text);

  font-size: 30rpx;

  font-weight: 500;

}



.group-card {

  margin-top: 8rpx;

}



.group-header {

  margin-bottom: 20rpx;

}



.group-title {

  font-size: 32rpx;

  color: var(--text-primary);

  font-weight: 600;

}



.owner-entry {

  width: 100%;

  box-sizing: border-box;

  margin-bottom: 24rpx;

  padding: 24rpx 24rpx;

  border-radius: var(--radius-md);

  background: linear-gradient(135deg, var(--brand-yellow-light) 0%, #FFFFFF 100%);

  border: 2rpx solid rgba(255, 209, 0, 0.3);

  display: flex;

  align-items: center;

  justify-content: space-between;

  transition: transform 0.2s;

}



.owner-entry:active {

  transform: scale(0.98);

}



.owner-entry-text {

  color: var(--text-primary);

  font-size: 28rpx;

  font-weight: 600;

}



.owner-entry-arrow {

  color: var(--brand-yellow-text);

  font-size: 36rpx;

  font-weight: 300;

}



.group-tabs {

  display: flex;

  gap: 0;

  margin-bottom: 24rpx;

  background: var(--card-bg);

  border-radius: var(--radius-md);

  padding: 6rpx;

  border: 1rpx solid var(--border-color);

}



.group-tab {

  flex: 1;

  text-align: center;

  padding: 18rpx 12rpx;

  border-radius: var(--radius-sm);

  background: transparent;

  color: var(--text-secondary);

  font-size: 26rpx;

  font-weight: 400;

  transition: all 0.25s;

}



.group-tab.active {

  background: var(--card-bg-elevated);

  color: var(--brand-yellow-text);

  font-weight: 600;

  box-shadow: var(--shadow-sm);

}



.group-btn {

  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);

  color: var(--bg-black);

  font-size: 28rpx;

  font-weight: 600;

  border-radius: var(--radius-md);

  flex: 1;

  box-shadow: 0 4rpx 16rpx var(--brand-yellow-glow);

}



.group-btn.apply {

  margin-top: 20rpx;

}



.group-list {

  margin-top: 8rpx;

}



.group-item {

  position: relative;

  padding: 24rpx 24rpx;

  padding-right: 100rpx;

  border-radius: var(--radius-md);

  border: 2rpx solid var(--border-color);

  margin-bottom: 16rpx;

  background: var(--card-bg-elevated);

  transition: border-color 0.2s, background 0.2s;

}



.group-item:active {

  border-color: var(--brand-yellow);

  background: var(--brand-yellow-light);

}



.group-item-enter {

  position: absolute;

  right: 24rpx;

  top: 50%;

  transform: translateY(-50%);

  font-size: 24rpx;

  color: var(--brand-yellow-text);

  font-weight: 500;

}



.group-item-name {

  color: var(--text-primary);

  font-size: 28rpx;

  font-weight: 500;

  display: block;

  margin-bottom: 6rpx;

}



.group-item-id {

  color: var(--text-tertiary);

  font-size: 22rpx;

}



.inline-empty {

  padding: 48rpx 24rpx;

}



.inline-empty .empty-state-icon {

  width: 96rpx;

  height: 96rpx;

  font-size: 44rpx;

}



.scanning-pulse {

  animation: pulse 1.5s infinite;

}



@keyframes pulse {

  0%, 100% { opacity: 1; transform: scale(1); }

  50% { opacity: 0.7; transform: scale(0.95); }

}



.admin-panel {

  margin-top: 20rpx;

  padding-top: 20rpx;

  border-top: 1rpx solid var(--border-color);

}



.admin-title {

  color: var(--text-primary);

  font-size: 28rpx;

  font-weight: 600;

  margin-bottom: 16rpx;

  display: block;

}



.effect-row,

.brightness-row {

  margin-top: 14rpx;

}



.brightness-row {

  margin-top: 20rpx;

}



.effect-label {

  color: var(--text-secondary);

  font-size: 24rpx;

}



.effect-grid {

  display: flex;

  flex-wrap: wrap;

  margin-top: 14rpx;

  margin-bottom: 16rpx;

  gap: 12rpx;

}



.effect-chip {

  box-sizing: border-box;

  width: calc(33.333% - 8rpx);

  padding: 18rpx 8rpx;

  text-align: center;

  border-radius: var(--radius-md);

  background: var(--card-bg);

  color: var(--text-secondary);

  font-size: 26rpx;

  border: 2rpx solid var(--border-color);

  line-height: 1.2;

  transition: all 0.2s;

}



.effect-chip.active {

  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);

  color: var(--bg-black);

  border-color: var(--brand-yellow);

  font-weight: 600;

  box-shadow: 0 4rpx 12rpx var(--brand-yellow-glow);

}



.detail-toolbar {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 16rpx;

}



.detail-back {

  color: var(--brand-yellow-text);

  font-size: 26rpx;

  font-weight: 500;

  padding: 8rpx 0;

}



.detail-danger {

  color: var(--error-red);

  font-size: 24rpx;

  padding: 8rpx 0;

}



.detail-title-block {

  display: flex;

  align-items: baseline;

  gap: 12rpx;

  margin-bottom: 16rpx;

  flex-wrap: wrap;

}



.detail-group-name {

  font-size: 36rpx;

  font-weight: 700;

  color: var(--text-primary);

}



.detail-group-id {

  font-size: 22rpx;

  color: var(--text-tertiary);

  background: var(--card-bg);

  padding: 4rpx 12rpx;

  border-radius: 8rpx;

}



.section-label {

  display: block;

  font-size: 26rpx;

  color: var(--text-secondary);

  margin-bottom: 8rpx;

}



.mini-wheel-wrap {

  display: flex;

  justify-content: center;

  align-items: center;

  margin-bottom: 8rpx;

}



.detail-admin-control {

  border-top: 1rpx solid var(--border-color);

  margin-top: 32rpx;

}



.member-presence {

  padding: 28rpx 24rpx;

  margin-top: 16rpx;

  background: var(--brand-yellow-light);

  border: 2rpx solid rgba(255, 209, 0, 0.2);

}



.presence-title {

  display: block;

  font-size: 26rpx;

  color: var(--text-secondary);

  margin-bottom: 12rpx;

}



.presence-value {

  display: block;

  font-size: 30rpx;

  color: var(--text-secondary);

  font-weight: 500;

  margin-bottom: 12rpx;

}



.presence-value.online {

  color: var(--success-green);

}



.presence-hint {

  display: block;

  font-size: 22rpx;

  color: var(--text-tertiary);

  line-height: 1.5;

}



.device-item {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 24rpx;

  margin-bottom: 16rpx;

  background-color: var(--card-bg);

  border-radius: var(--radius-md);

  border: 2rpx solid transparent;

}



.device-item:active {

  border-color: var(--brand-yellow);

  background: var(--brand-yellow-light);

}



.device-item-name {

  font-size: 28rpx;

  color: var(--text-primary);

  font-weight: 500;

}



.device-connected-tag {

  font-size: 20rpx;

  color: var(--brand-yellow-text);

  background: var(--brand-yellow-light);

  padding: 4rpx 12rpx;

  border-radius: 8rpx;

}



.rssi-text {

  font-size: 22rpx;

  color: var(--text-tertiary);

}



.group-input {

  width: 100%;

  height: 88rpx;

  background: var(--card-bg);

  border-radius: var(--radius-md);

  padding: 0 24rpx;

  color: var(--text-primary);

  font-size: 28rpx;

  margin-bottom: 16rpx;

  box-sizing: border-box;

  border: 2rpx solid var(--border-color);

}



.password-switch-row {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 16rpx;

  padding: 8rpx 4rpx;

}



.password-switch-label {

  color: var(--text-primary);

  font-size: 28rpx;

}

/* 管理员统一下发：与调光页一致 */
.admin-lighting {
  margin-top: 24rpx;
  padding-top: 8rpx;
}

.admin-lighting-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 28rpx;
}

.lighting-section {
  margin-bottom: 36rpx;
}

.lighting-label,
.slider-label {
  display: block;
  font-size: 26rpx;
  color: #9E9E9E;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.admin-lighting .power-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.power-info {
  display: flex;
  flex-direction: column;
}

.power-status {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.power-desc {
  font-size: 24rpx;
  color: #9E9E9E;
}

.power-switch {
  transform: scale(0.92);
}

.admin-lighting .mode-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 8rpx 0;
}

.admin-lighting .mode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.admin-lighting .mode-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.admin-lighting .mode-icon-img {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.admin-lighting .mode-icon-img.is-dim {
  opacity: 0.4;
}

.admin-lighting .mode-name {
  font-size: 22rpx;
  color: #757575;
  text-align: center;
}

.admin-lighting .mode-item.disabled .mode-name {
  color: #BDBDBD;
}

.admin-lighting .mode-item.active .mode-name {
  color: #1A1A1A;
  font-weight: 600;
}

.admin-lighting .color-wheel-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8rpx 0;
}

.admin-lighting.is-powered-off .color-wheel-section {
  opacity: 0.4;
  pointer-events: none;
}

.admin-lighting .slider-section {
  padding-right: 8rpx;
}

.admin-lighting .plain-slider {
  margin: 0;
  width: 100%;
}


