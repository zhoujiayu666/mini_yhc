@import "../shop-common/shop-common.wxss";

.order-time {
  font-size: 24rpx;
  color: #9E9E9E;
}

.order-foot-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-delete {
  margin: 0;
  padding: 0 24rpx;
  min-width: 0;
  min-height: 0;
  height: 56rpx;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #F44336;
  background: #FFF5F5;
  border-radius: 28rpx;
}

.order-delete::after {
  border: none;
}

.order-logistics {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 4rpx 0 16rpx;
  padding: 12rpx 16rpx;
  background: #F7F7F8;
  border-radius: 12rpx;
}

.order-logistics-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9E9E9E;
  line-height: 1.5;
}

.order-logistics-text {
  flex: 1;
  font-size: 24rpx;
  color: #424242;
  line-height: 1.5;
  word-break: break-all;
}

.order-logistics.in_transit .order-logistics-text {
  color: #C89600;
}

.order-logistics.signed .order-logistics-text {
  color: #4CAF50;
}
