page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffbf0 0%, #ffffff 50%);
}

.login-page {
  min-height: 100vh;
  padding: 48rpx 48rpx 48rpx;
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #9e9e9e;
  text-align: center;
}

.login-form {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.phone-login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0;
  padding: 0;
  border: none;
  outline: none;
  box-shadow: none;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ffd100 0%, #ffc400 100%);
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 600;
}

.phone-login-btn::after {
  display: none;
}

.phone-login-btn-hover {
  opacity: 0.88;
}

.other-login-link {
  display: block;
  text-align: center;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #757575;
}

.manual-block {
  margin-top: 28rpx;
}

.input-row {
  display: flex;
  align-items: center;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  height: 96rpx;
  box-sizing: border-box;
}

.input-prefix {
  font-size: 30rpx;
  color: #1a1a1a;
  margin-right: 16rpx;
}

.phone-input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
}

.login-btn {
  background: linear-gradient(135deg, #ffd100 0%, #ffc400 100%);
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
}

.login-btn::after,
.skip-btn::after {
  border: none;
}

.agreement-block {
  margin-top: 36rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
}

.agree-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #bdbdbd;
  margin-right: 12rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.agree-check.checked {
  border-color: #ffc400;
  background: #ffc400;
  position: relative;
}

.agree-check.checked::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 4rpx;
  width: 10rpx;
  height: 16rpx;
  border: 2rpx solid #1a1a1a;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}

.agreement-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.65;
}

.agree-plain {
  color: #616161;
}

.agree-link {
  color: #2f6bff;
}

.agree-tip {
  display: block;
  margin-top: 12rpx;
  padding-left: 44rpx;
  font-size: 22rpx;
  color: #9e9e9e;
  line-height: 1.55;
}

.skip-btn {
  margin-top: 24rpx;
  background: transparent;
  color: #9e9e9e;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}
