<page-nav-bar back="{{true}}"></page-nav-bar>
<view class="login-page">
  <view class="login-header">
    <text class="login-title">欢迎使用</text>
    <text class="login-subtitle">{{hint}}</text>
  </view>

  <view class="login-form">
    <view class="wx-login-wrap">
      <text class="wx-login-text">手机号快捷登录</text>
      <button
        wx:if="{{agreed}}"
        class="wx-login-cover"
        open-type="getPhoneNumber"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindgetphonenumber="onGetPhoneNumber"
      />
      <view wx:else class="wx-login-cover" bindtap="onNeedAgree"></view>
    </view>

    <text class="other-login-link" bindtap="onToggleManual">其他号码登录</text>

    <view class="manual-block" wx:if="{{showManual}}">
      <view class="input-row">
        <text class="input-prefix">+86</text>
        <input
          class="phone-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>
      <button class="login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">登录</button>
    </view>

    <view class="agreement-block">
      <view class="agreement-row" bindtap="onToggleAgree">
        <view class="agree-check {{agreed ? 'checked' : ''}}"></view>
        <text class="agreement-text">
          <text class="agree-plain">已阅读并同意</text>
          <text class="agree-link" catchtap="onOpenUserAgreement">《用户协议》</text>
          <text class="agree-plain">及</text>
          <text class="agree-link" catchtap="onOpenPrivacy">《隐私政策》</text>
        </text>
      </view>
      <text class="agree-tip">若您的手机号未注册，将为您直接注册 TOPUYI 账号</text>
    </view>

    <button class="skip-btn" bindtap="onSkipLogin">暂不登录，先去逛逛</button>
  </view>
</view>
