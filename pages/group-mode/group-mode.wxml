<navigation-bar title="群组模式" back="{{true}}" color="#E0E0E0" background="#121212"></navigation-bar>

<scroll-view class="scrollarea" scroll-y>
  <view class="container">
    <view class="page-back-entry" bindtap="goBackPage">
      <text class="page-back-arrow">‹</text>
      <text class="page-back-text">返回</text>
    </view>

    <!-- 列表模式 -->
    <block wx:if="{{!groupDetailMode}}">
      <view class="group-card card">
        <view class="owner-entry" bindtap="openCreateGroupModal">
          <text class="owner-entry-text">创建群组</text>
          <text class="owner-entry-arrow">›</text>
        </view>
        <view class="owner-entry" bindtap="openJoinGroupModal">
          <text class="owner-entry-text">加入群组</text>
          <text class="owner-entry-arrow">›</text>
        </view>

        <view class="group-header">
          <text class="group-title">群组控制</text>
        </view>

        <view class="group-tabs">
          <view class="group-tab {{groupTab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchGroupTab">我的群组</view>
          <view class="group-tab {{groupTab === 'joined' ? 'active' : ''}}" data-tab="joined" bindtap="switchGroupTab">加入过的群组</view>
        </view>

        <view class="group-list" wx:if="{{filteredGroups.length > 0}}">
          <view
          class="group-item"
            wx:for="{{filteredGroups}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="openGroupDetail"
          >
            <text class="group-item-name">{{item.name}}</text>
            <text class="group-item-id">ID: {{item.id}} | 成员: {{item.members.length}}</text>
            <text class="group-item-enter">进入 ›</text>
          </view>
        </view>
        <view class="empty-tip-box" wx:if="{{filteredGroups.length === 0}}">
          <text class="empty-tip-text">{{groupTab === 'mine' ? '暂无我创建的群组' : '暂无加入过的群组'}}</text>
        </view>
      </view>
    </block>

    <!-- 群组详情 -->
    <block wx:else>
      <view class="group-card card">
        <view class="detail-toolbar">
          <view class="detail-back" bindtap="exitGroupDetail">返回列表</view>
          <view
            class="detail-danger"
            wx:if="{{activeUserRole === 'admin'}}"
            bindtap="confirmDismissGroup"
          >解散群组</view>
          <view
            class="detail-danger"
            wx:elif="{{activeUserRole === 'member'}}"
            bindtap="confirmLeaveGroup"
          >退出群组</view>
        </view>
        <view class="status-card card">
          <view class="status-header">
            <view class="status-indicator">
              <view class="status-dot {{isConnected ? 'connected' : ''}}"></view>
              <block wx:if="{{isConnected}}">
                <text class="status-text">已连接</text>
                <text class="status-device-inline" wx:if="{{currentDevice}}">
                  {{currentDevice.name || currentDevice.deviceId}}
                </text>
              </block>
              <text class="status-text" wx:else>未连接设备</text>
            </view>
            <view class="status-action" bindtap="openDeviceConnectPanel">
              <text class="action-text">连接</text>
            </view>
          </view>
        </view>
        <view class="detail-title-block">
          <text class="detail-group-name">{{activeGroup.name}}</text>
          <text class="detail-group-id">ID: {{activeGroup.id}}</text>
        </view>

        <!-- 管理员：缩小版调光 + 统一下发 -->
        <block wx:if="{{activeUserRole === 'admin'}}">
          <text class="section-label">调光预览（下发参数）</text>
          <view class="mini-wheel-wrap">
            <color-wheel
              hue="{{previewHue}}"
              saturation="{{previewSaturation}}"
              brightness="{{previewBrightness}}"
              size="{{360}}"
              bindchange="onPreviewColorChange"
            ></color-wheel>
          </view>

          <view class="admin-panel detail-admin-control">
            <text class="admin-title">统一下发（成员灯光）</text>
            <view class="effect-row">
              <text class="effect-label">效果</text>
              <view class="effect-grid">
                <view class="effect-chip {{groupControlEffect === '黑场' ? 'active' : ''}}" data-effect="黑场" bindtap="onControlEffectChange">黑场</view>
                <view class="effect-chip {{groupControlEffect === '常亮' ? 'active' : ''}}" data-effect="常亮" bindtap="onControlEffectChange">常亮</view>
                <view class="effect-chip {{groupControlEffect === '随机' ? 'active' : ''}}" data-effect="随机" bindtap="onControlEffectChange">随机</view>
                <view class="effect-chip {{groupControlEffect === '快闪' ? 'active' : ''}}" data-effect="快闪" bindtap="onControlEffectChange">快闪</view>
                <view class="effect-chip {{groupControlEffect === '眨眼' ? 'active' : ''}}" data-effect="眨眼" bindtap="onControlEffectChange">眨眼</view>
                <view class="effect-chip {{groupControlEffect === '呼吸' ? 'active' : ''}}" data-effect="呼吸" bindtap="onControlEffectChange">呼吸</view>
                <view class="effect-chip {{groupControlEffect === '聚会' ? 'active' : ''}}" data-effect="聚会" bindtap="onControlEffectChange">聚会</view>
                <view class="effect-chip {{groupControlEffect === '彩虹' ? 'active' : ''}}" data-effect="彩虹" bindtap="onControlEffectChange">彩虹</view>
                <view class="effect-chip {{groupControlEffect === '星空' ? 'active' : ''}}" data-effect="星空" bindtap="onControlEffectChange">星空</view>
              </view>
            </view>
            <view class="brightness-row">
              <text class="effect-label">下发亮度 {{groupControlBrightness}}%</text>
              <slider min="1" max="100" step="1" value="{{groupControlBrightness}}" activeColor="#FFD100" backgroundColor="#333333" bindchange="onControlBrightnessChange" />
            </view>
            <button class="group-btn apply" bindtap="applyGroupControl">统一下发到成员</button>
          </view>
        </block>

        <!-- 成员：管理员是否在本群详情页 -->
        <block wx:else>
          <view class="member-presence card">
            <text class="presence-title">管理员状态</text>
            <text class="presence-value {{activeGroup.adminIsInGroupDetail ? 'online' : ''}}">
              {{activeGroup.adminIsInGroupDetail ? '管理员正在本群组页面' : '管理员未进入本群组页面'}}
            </text>
            <text class="presence-hint">说明：管理员在本群详情内操作或统一下发后，约 60 秒内会显示为「正在本群组页面」</text>
          </view>
        </block>
      </view>
    </block>
  </view>
</scroll-view>

<view class="group-modal {{showCreateGroupModal ? 'show' : ''}}" bindtap="closeCreateGroupModal">
  <view class="group-modal-content" catchtap="stopPropagation">
    <view class="group-modal-header">
      <text class="group-modal-title">创建新群组</text>
      <view class="close-btn" bindtap="closeCreateGroupModal">×</view>
    </view>
    <view class="group-modal-body">
      <input class="group-input" placeholder="请输入群组名称" data-field="name" value="{{createGroupForm.name}}" bindinput="onCreateGroupInput" />
      <input class="group-input" placeholder="请输入群组ID" data-field="id" value="{{createGroupForm.id}}" bindinput="onCreateGroupInput" />
      <input class="group-input" placeholder="请输入4位数字密码" type="number" maxlength="4" data-field="password" value="{{createGroupForm.password}}" bindinput="onCreateGroupInput" />
      <button class="group-btn apply" bindtap="createGroup">确认创建</button>
    </view>
  </view>
</view>

<view class="device-list-modal {{showDeviceList ? 'show' : ''}}" bindtap="closeDeviceList">
  <view class="device-list-content" catchtap="stopPropagation">
    <view class="device-list-header">
      <text class="device-list-title">选择设备</text>
      <view class="close-btn" bindtap="closeDeviceList">×</view>
    </view>
    <view class="device-list-body">
      <view class="device-item" wx:for="{{deviceList}}" wx:key="deviceId" data-deviceid="{{item.deviceId}}" bindtap="connectDevice">
        <view class="device-info">
          <view class="device-name-row">
            <text class="device-item-name">{{item.name || item.deviceId || '未知设备'}}</text>
            <text class="device-connected-tag" wx:if="{{item.isConnectedDevice}}">已连接</text>
          </view>
        </view>
        <view class="device-rssi">
          <text class="rssi-text">信号: {{item.RSSI || '未知'}}</text>
        </view>
      </view>
      <view class="device-list-empty" wx:if="{{deviceList.length === 0 && !isScanning}}">
        <text class="empty-text">未发现设备</text>
        <text class="empty-tip">请确保蓝牙已开启，且设备在附近并处于可连接状态</text>
      </view>
      <view class="device-list-scanning" wx:if="{{isScanning}}">
        <text class="scanning-text">正在搜索设备...</text>
      </view>
    </view>
  </view>
</view>

<view class="group-modal {{showJoinGroupModal ? 'show' : ''}}" bindtap="closeJoinGroupModal">
  <view class="group-modal-content" catchtap="stopPropagation">
    <view class="group-modal-header">
      <text class="group-modal-title">加入群组</text>
      <view class="close-btn" bindtap="closeJoinGroupModal">×</view>
    </view>
    <view class="group-modal-body">
      <input class="group-input" placeholder="请输入群组ID" data-field="id" value="{{joinGroupForm.id}}" bindinput="onJoinGroupInput" />
      <input class="group-input" placeholder="请输入昵称" data-field="nickname" value="{{joinGroupForm.nickname}}" bindinput="onJoinGroupInput" />
      <input class="group-input" placeholder="请输入4位数字密码" type="number" maxlength="4" data-field="password" value="{{joinGroupForm.password}}" bindinput="onJoinGroupInput" />
      <button class="group-btn apply" bindtap="joinGroup">确认加入</button>
    </view>
  </view>
</view>
