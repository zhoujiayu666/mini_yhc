page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #121212;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.container {
  padding: 32rpx;
}

.group-card {
  margin-top: 8rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 30rpx;
  color: #E0E0E0;
  font-weight: 500;
}

.group-subtitle {
  font-size: 22rpx;
  color: #9E9E9E;
}

.group-actions {
  display: flex;
  gap: 16rpx;
}

.owner-entry {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 22rpx 20rpx;
  border-radius: 12rpx;
  background: #2A2A2A;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.owner-entry-text {
  color: #E0E0E0;
  font-size: 26rpx;
}

.owner-entry-arrow {
  color: #9E9E9E;
  font-size: 30rpx;
}

.group-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.group-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  background: #2A2A2A;
  color: #BDBDBD;
  font-size: 24rpx;
}

.group-tab.active {
  background: #FFD100;
  color: #121212;
}

.group-btn {
  background: #FFD100;
  color: #121212;
  font-size: 26rpx;
  border-radius: 12rpx;
  flex: 1;
}

.group-btn.ghost {
  background: #2A2A2A;
  color: #E0E0E0;
  border: 1rpx solid #3a3a3a;
}

.group-btn.apply {
  margin-top: 20rpx;
}

.group-list {
  margin-top: 16rpx;
}

.group-item {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #333333;
  margin-bottom: 12rpx;
}

.group-item.active {
  border-color: #FFD100;
}

.group-item-name {
  color: #E0E0E0;
  font-size: 26rpx;
  display: block;
}

.group-item-id {
  color: #9E9E9E;
  font-size: 22rpx;
}

.empty-tip-box {
  margin-top: 20rpx;
  padding: 26rpx 20rpx;
  border-radius: 12rpx;
  background: #1B1B1B;
}

.empty-tip-text {
  color: #9E9E9E;
  font-size: 24rpx;
}

.admin-panel {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #333333;
}

.admin-title {
  color: #E0E0E0;
  font-size: 26rpx;
  margin-bottom: 14rpx;
  display: block;
}

.effect-row,
.brightness-row {
  margin-top: 14rpx;
}

.effect-label {
  color: #BDBDBD;
  font-size: 22rpx;
}

.effect-options {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.effect-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #2A2A2A;
  color: #D0D0D0;
  font-size: 22rpx;
}

.effect-chip.active {
  background: #FFD100;
  color: #121212;
}

.member-list {
  margin-top: 20rpx;
}

.member-item {
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: #1B1B1B;
  margin-bottom: 10rpx;
}

.member-name {
  color: #E0E0E0;
  font-size: 24rpx;
  display: block;
}

.member-state {
  color: #9E9E9E;
  font-size: 22rpx;
}

.group-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.group-modal.show {
  opacity: 1;
  visibility: visible;
}

.group-modal-content {
  width: 82%;
  max-width: 620rpx;
  background: #1E1E1E;
  border-radius: 24rpx;
  overflow: hidden;
}

.group-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #333333;
}

.group-modal-title {
  color: #E0E0E0;
  font-size: 30rpx;
}

.group-modal-body {
  padding: 24rpx 28rpx 32rpx;
}

.group-input {
  width: 100%;
  height: 78rpx;
  background: #2A2A2A;
  border-radius: 12rpx;
  padding: 0 20rpx;
  color: #E0E0E0;
  font-size: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
