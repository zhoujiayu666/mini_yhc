page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #121212;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.container {
  padding: 32rpx;
}

.status-card {
  margin: 0 0 14rpx;
  padding: 0;
  background: transparent;
  box-shadow: none;
  border-radius: 0;
}

.status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0;
}

.status-indicator {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #9E9E9E;
  margin-right: 10rpx;
}

.status-dot.connected {
  background-color: #4CAF50;
}

.status-text {
  font-size: 26rpx;
  color: #E0E0E0;
  font-weight: 500;
}

.status-device-inline {
  margin-left: 10rpx;
  max-width: 360rpx;
  font-size: 23rpx;
  color: #9E9E9E;
}

.status-action {
  padding: 7rpx 14rpx;
  background-color: #333333;
  border-radius: 8rpx;
}

.action-text {
  font-size: 23rpx;
  color: #FFD100;
}

.status-info {
  margin-top: 0;
}

.current-device-name {
  font-size: 23rpx;
  color: #9E9E9E;
}

.page-back-entry {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  margin-bottom: 18rpx;
  padding: 0;
}

.page-back-arrow {
  display: block;
  color: #FFD100;
  font-size: 58rpx;
  line-height: 64rpx;
  margin-right: 12rpx;
}

.page-back-text {
  display: block;
  color: #FFD100;
  font-size: 34rpx;
  line-height: 64rpx;
}

.group-card {
  margin-top: 8rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 30rpx;
  color: #E0E0E0;
  font-weight: 500;
}

.group-subtitle {
  font-size: 22rpx;
  color: #9E9E9E;
}

.group-actions {
  display: flex;
  gap: 16rpx;
}

.owner-entry {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 22rpx 20rpx;
  border-radius: 12rpx;
  background: #2A2A2A;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.owner-entry-text {
  color: #E0E0E0;
  font-size: 26rpx;
}

.owner-entry-arrow {
  color: #9E9E9E;
  font-size: 30rpx;
}

.group-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.group-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  background: #1E1E1E;
  color: #9E9E9E;
  font-size: 26rpx;
  border: 2rpx solid #333333;
  font-weight: 400;
}

.group-tab.active {
  background: #2A2410;
  color: #FFD100;
  border-color: #FFD100;
  font-weight: 600;
}

.group-btn {
  background: #FFD100;
  color: #121212;
  font-size: 26rpx;
  border-radius: 12rpx;
  flex: 1;
}

.group-btn.ghost {
  background: #2A2A2A;
  color: #E0E0E0;
  border: 1rpx solid #3a3a3a;
}

.group-btn.apply {
  margin-top: 20rpx;
}

.group-list {
  margin-top: 16rpx;
}

.group-item {
  position: relative;
  padding: 18rpx 20rpx;
  padding-right: 100rpx;
  border-radius: 12rpx;
  border: 2rpx solid #333333;
  margin-bottom: 12rpx;
}

.group-item.selected {
  border-color: #FFD100;
  background: rgba(255, 209, 0, 0.08);
}

.group-item-enter {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #FFD100;
}

.group-item-name {
  color: #E0E0E0;
  font-size: 26rpx;
  display: block;
}

.group-item-id {
  color: #9E9E9E;
  font-size: 22rpx;
}

.empty-tip-box {
  margin-top: 20rpx;
  padding: 26rpx 20rpx;
  border-radius: 12rpx;
  background: #1B1B1B;
}

.empty-tip-text {
  color: #9E9E9E;
  font-size: 24rpx;
}

.admin-panel {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #333333;
}

.admin-title {
  color: #E0E0E0;
  font-size: 26rpx;
  margin-bottom: 14rpx;
  display: block;
}

.effect-row,
.brightness-row {
  margin-top: 14rpx;
}

.brightness-row {
  margin-top: 20rpx;
}

.effect-label {
  color: #BDBDBD;
  font-size: 22rpx;
}

.effect-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
  margin-bottom: 16rpx;
  justify-content: space-between;
}

.effect-chip {
  box-sizing: border-box;
  width: 32%;
  padding: 18rpx 8rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #2A2A2A;
  color: #D0D0D0;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  margin-bottom: 12rpx;
  line-height: 1.2;
}

.effect-chip.active {
  background: #FFD100;
  color: #121212;
  border-color: #FFD100;
}

.member-list {
  margin-top: 20rpx;
}

.member-item {
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: #1B1B1B;
  margin-bottom: 10rpx;
}

.member-name {
  color: #E0E0E0;
  font-size: 24rpx;
  display: block;
}

.member-state {
  color: #9E9E9E;
  font-size: 22rpx;
}

.group-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.device-list-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.device-list-modal.show {
  opacity: 1;
  visibility: visible;
}

.device-list-content {
  width: 82%;
  max-width: 620rpx;
  max-height: 80vh;
  background: #1E1E1E;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.device-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid #333333;
}

.device-list-title {
  color: #E0E0E0;
  font-size: 30rpx;
}

.device-list-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx;
  margin-bottom: 14rpx;
  background-color: #2A2A2A;
  border-radius: 14rpx;
}

.device-info {
  flex: 1;
}

.device-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.device-item-name {
  font-size: 27rpx;
  color: #E0E0E0;
}

.device-connected-tag {
  font-size: 22rpx;
  color: #FFD100;
}

.device-rssi {
  margin-left: 14rpx;
}

.rssi-text {
  font-size: 22rpx;
  color: #9E9E9E;
}

.device-list-empty,
.device-list-scanning {
  padding: 60rpx 20rpx;
  text-align: center;
}

.empty-text,
.scanning-text {
  font-size: 28rpx;
  color: #9E9E9E;
  display: block;
}

.empty-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #9E9E9E;
  line-height: 1.6;
}

.group-modal.show {
  opacity: 1;
  visibility: visible;
}

.group-modal-content {
  width: 82%;
  max-width: 620rpx;
  background: #1E1E1E;
  border-radius: 24rpx;
  overflow: hidden;
}

.group-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #333333;
}

.group-modal-title {
  color: #E0E0E0;
  font-size: 30rpx;
}

.group-modal-body {
  padding: 24rpx 28rpx 32rpx;
}

.group-input {
  width: 100%;
  height: 78rpx;
  background: #2A2A2A;
  border-radius: 12rpx;
  padding: 0 20rpx;
  color: #E0E0E0;
  font-size: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.detail-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.detail-back {
  display: inline-block;
  color: #FFD100;
  font-size: 26rpx;
  padding: 8rpx 0;
}

.detail-danger {
  color: #FF6B6B;
  font-size: 24rpx;
  padding: 8rpx 0;
}

.detail-title-block {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.detail-group-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #E0E0E0;
}

.detail-group-id {
  font-size: 22rpx;
  color: #9E9E9E;
}

.section-label {
  display: block;
  font-size: 26rpx;
  color: #BDBDBD;
  margin-bottom: 6rpx;
}

.mini-wheel-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 4rpx;
}

.detail-admin-control {
  border-top: 1rpx solid #333333;
  margin-top: 32rpx;
}

.member-presence {
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
}

.presence-title {
  display: block;
  font-size: 26rpx;
  color: #BDBDBD;
  margin-bottom: 12rpx;
}

.presence-value {
  display: block;
  font-size: 28rpx;
  color: #9E9E9E;
  margin-bottom: 16rpx;
}

.presence-value.online {
  color: #4CAF50;
}

.presence-hint {
  display: block;
  font-size: 22rpx;
  color: #757575;
  line-height: 1.5;
}
