page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F7F7F8;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.shop-page {
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
}

.section-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.addr-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.addr-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-right: 20rpx;
}

.addr-phone {
  font-size: 28rpx;
  color: #757575;
}

.addr-detail {
  display: block;
  font-size: 26rpx;
  color: #757575;
  line-height: 1.5;
  padding-right: 40rpx;
}

.addr-empty {
  font-size: 28rpx;
  color: #9E9E9E;
}

.addr-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #BDBDBD;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #757575;
  padding: 8rpx 0;
}

.summary-row.total {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
  color: #1A1A1A;
  font-weight: 600;
}

.pay-amount {
  color: #F44336;
  font-size: 32rpx;
}

.empty-wrap {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #9E9E9E;
}

.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #9E9E9E;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
  color: #C89600;
}

.order-status.done {
  color: #4CAF50;
}

.order-status.cancel {
  color: #9E9E9E;
}

.order-item-line {
  font-size: 26rpx;
  color: #424242;
  line-height: 1.6;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.order-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.btn-outline,
.btn-primary {
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 32rpx;
}

.btn-outline {
  background: #FFFFFF;
  color: #424242;
  border: 1rpx solid #E0E0E0;
}

.btn-primary {
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  color: #1A1A1A;
  font-weight: 600;
}

.btn-outline::after,
.btn-primary::after {
  border: none;
}

.form-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 20rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #757575;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.tabs-row {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 20rpx;
  overflow-x: auto;
}

.tab-chip {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #757575;
  background: #FFFFFF;
}

.tab-chip.active {
  background: #FFF8E1;
  color: #C89600;
  font-weight: 600;
}
