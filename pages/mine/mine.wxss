page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.mine-page {
  padding: 24rpx 40rpx calc(100rpx + env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 40rpx;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 28rpx;
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.profile-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.profile-label {
  font-size: 24rpx;
  color: #9E9E9E;
  margin-bottom: 8rpx;
}

.profile-phone {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.profile-tag {
  align-self: flex-start;
  font-size: 22rpx;
  color: #9E9E9E;
  background: #F7F7F8;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.profile-tag.cloud {
  color: #C89600;
  background: rgba(255, 209, 0, 0.15);
}

.section {
  margin-bottom: 40rpx;
}

.section-label {
  display: block;
  font-size: 26rpx;
  color: #9E9E9E;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
}

.menu-item:active {
  background: #FAFAFA;
}

.menu-title {
  font-size: 30rpx;
  color: #1A1A1A;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C4C4C4;
  line-height: 1;
}

.logout-wrap {
  margin-top: 16rpx;
}

.logout-btn {
  background: #FFFFFF;
  color: #F44336;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.logout-btn::after {
  border: none;
}
