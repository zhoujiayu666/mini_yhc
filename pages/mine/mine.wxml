<page-nav-bar></page-nav-bar>
<scroll-view class="scrollarea" scroll-y>
  <view class="mine-page">
    <view class="profile-card {{loggedIn ? '' : 'profile-card-tap'}}" bindtap="{{loggedIn ? '' : 'onGoLogin'}}">
      <view class="avatar-wrap">
        <text class="avatar-text">{{avatarLetter}}</text>
      </view>
      <view class="profile-info">
        <text class="profile-label" wx:if="{{loggedIn}}">手机号</text>
        <text class="profile-label" wx:else>账号</text>
        <text class="profile-phone">{{phoneDisplay}}</text>
        <text class="profile-tag cloud" wx:if="{{memberReady}}">TOPUYI 会员</text>
        <text class="profile-tag cloud" wx:elif="{{loggedIn}}">已登录</text>
        <text class="profile-hint" wx:else>注册即成为会员，购物可获得积分</text>
      </view>
      <text class="profile-arrow" wx:if="{{!loggedIn}}">›</text>
    </view>

    <view class="points-card" wx:if="{{loggedIn}}">
      <view class="points-heading"><text>我的积分</text><text class="points-link" bindtap="onPointsHistory">积分明细 ›</text></view>
      <text class="points-balance">{{pointsLoading ? '加载中…' : (memberReady ? points : '—')}}</text>
      <view class="points-error" wx:if="{{pointsError}}"><text>{{pointsError}}</text><text class="points-link" bindtap="loadProfile">重新获取</text></view>
      <text class="points-rule">支付成功后，每笔订单实付满 1 元积 1 分，不足 1 元不计分。</text>
    </view>
    <view class="points-history" wx:if="{{historyOpen}}">
      <view class="points-heading"><text>最近 30 条积分明细</text><text class="points-link" bindtap="onCloseHistory">收起</text></view>
      <text class="points-rule" wx:if="{{historyLoading}}">正在获取明细…</text>
      <view wx:elif="{{historyError}}"><text class="points-error">{{historyError}}</text><text class="points-link" bindtap="onPointsHistory">重试</text></view>
      <text class="points-rule" wx:elif="{{!pointEntries.length}}">暂无积分记录</text>
      <view class="points-row" wx:for="{{pointEntries}}" wx:key="id"><view class="points-row-info"><text>{{item.title}} · {{item.dateText}}</text><text class="points-order">订单 {{item.orderNo}}</text></view><text class="points-delta">{{item.deltaText}}</text></view>
    </view>

    <view class="section">
      <text class="section-label">商城</text>
      <view class="menu-card">
        <view class="menu-item" bindtap="onGoOrders">
          <text class="menu-title">我的订单</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onGoRedemptions"><text class="menu-title">我的兑换订单</text><text class="menu-arrow">›</text></view>
        <view class="menu-item" bindtap="onGoAddresses">
          <text class="menu-title">收货地址</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-label">设备</text>
      <view class="menu-card">
        <view class="menu-item" bindtap="onGoDevices"><text class="menu-title">我的设备</text><text class="menu-arrow">›</text></view>
        <view class="menu-item" bindtap="onGoConnectGuide">
          <text class="menu-title">设备连接引导</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-label">软件中心</text>
      <view class="menu-card">
        <view
          class="menu-item"
          wx:for="{{softwareList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onGoSoftware"
        >
          <text class="menu-title">{{item.name}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="logout-wrap" wx:if="{{loggedIn}}">
      <button class="logout-btn" bindtap="onLogoutTap">退出登录</button>
    </view>
  </view>
</scroll-view>

<main-tab-bar current="mine"></main-tab-bar>
