<page-nav-bar title="全部商品"></page-nav-bar><view class="page-shell"><view class="search"><text>⌕</text><input placeholder="搜索商品" value="{{keyword}}" bindinput="onSearch"/></view><image wx:if="{{banner}}" class="banner" src="{{banner}}" mode="aspectFill"/><view class="catalog"><scroll-view class="categories" scroll-y><view wx:for="{{categories}}" wx:key="*this" class="category {{active===item?'active':''}}" data-name="{{item}}" bindtap="chooseCategory">{{item}}</view></scroll-view><scroll-view class="products" scroll-y enhanced><view class="product" wx:for="{{shown}}" wx:key="sku" data-sku="{{item.sku}}" bindtap="openProduct"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load/><view wx:else class="placeholder">商品图片</view><view class="info"><text class="name">{{item.title}}</text><text class="desc" wx:if="{{item.subtitle}}">{{item.subtitle}}</text><view class="buy"><text class="price">{{item.priceText?'¥'+item.priceText:'暂不可用'}}</text><button data-sku="{{item.sku}}" catchtap="addCart" disabled="{{!item.available}}">＋</button></view></view></view><view class="empty" wx:if="{{!loading&&!shown.length}}">没有找到商品</view></scroll-view></view></view><view class="floating-cart" bindtap="openCart" role="button" aria-label="购物车"><view class="cart-drawing"><view class="cart-handle"></view><view class="cart-basket"></view><view class="cart-wheel cart-wheel-left"></view><view class="cart-wheel cart-wheel-right"></view></view><text class="floating-cart-count" wx:if="{{cartCount}}">{{cartCount > 99 ? "99+" : cartCount}}</text></view>
<main-tab-bar current="products"></main-tab-bar>
