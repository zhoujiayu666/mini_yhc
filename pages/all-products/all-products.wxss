page{height:100vh;background:#fff;color:#20232a}.page-shell{height:calc(100vh - 210rpx);display:flex;flex-direction:column}.search{margin:18rpx 24rpx;min-height:72rpx;padding:0 24rpx;display:flex;align-items:center;gap:16rpx;background:#f5f6f8;border-radius:40rpx;color:#9299a4}.search text{font-size:44rpx}.search input{flex:1;font-size:27rpx}.banner{display:block;width:100%;height:230rpx;background:#f0f1f4}.catalog{flex:1;min-height:0;display:flex;border-top:1rpx solid #f0f1f3}.categories{width:190rpx;height:100%;background:#f6f7f9}.category{padding:34rpx 18rpx;font-size:27rpx;color:#666;text-align:center;border-left:6rpx solid transparent}.category.active{background:#fff;color:#1f2530;font-weight:650;border-left-color:#ffd100}.products{flex:1;height:100%;padding:20rpx;box-sizing:border-box}.product{display:flex;gap:20rpx;padding:0 0 24rpx;margin-bottom:24rpx;border-bottom:1rpx solid #f0f1f3}.product>image,.placeholder{width:220rpx;height:220rpx;flex-shrink:0;border-radius:12rpx;background:#eef0f4}.placeholder{display:flex;align-items:center;justify-content:center;color:#9da6b3;font-size:23rpx}.info{flex:1;min-width:0;display:flex;flex-direction:column}.name{font-size:28rpx;font-weight:600;line-height:1.45}.desc{margin-top:10rpx;font-size:23rpx;color:#9097a2;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.buy{margin-top:auto;display:flex;align-items:center;justify-content:space-between}.price{font-size:34rpx;color:#d54c2d;font-weight:700}.buy button{width:58rpx;height:58rpx;line-height:56rpx;margin:0;padding:0;border-radius:50%;background:#ffd100;font-size:31rpx}.buy button::after{border:0}.empty{padding:150rpx 20rpx;text-align:center;color:#9ba3ae}

.floating-cart{position:fixed;z-index:110;right:28rpx;bottom:140rpx;bottom:calc(140rpx + env(safe-area-inset-bottom));width:94rpx;height:94rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff;box-shadow:0 6rpx 28rpx rgba(0,0,0,.18);border:1rpx solid #eee}.floating-cart-icon{font-size:48rpx;line-height:1}.floating-cart-count{position:absolute;right:-2rpx;top:-4rpx;min-width:34rpx;height:34rpx;padding:0 8rpx;box-sizing:border-box;border-radius:18rpx;background:#ef4444;color:#fff;font-size:21rpx;line-height:34rpx;text-align:center}
.cart-drawing{position:relative;width:52rpx;height:52rpx}.cart-handle{position:absolute;left:0;top:5rpx;width:12rpx;height:5rpx;background:#171b20;border-radius:3rpx}.cart-basket{position:absolute;left:11rpx;top:10rpx;width:36rpx;height:27rpx;border:4rpx solid #171b20;border-top-width:5rpx;border-radius:2rpx 2rpx 5rpx 5rpx;transform:skewX(-8deg);box-sizing:border-box}.cart-wheel{position:absolute;bottom:3rpx;width:7rpx;height:7rpx;border-radius:50%;background:#171b20}.cart-wheel-left{left:14rpx}.cart-wheel-right{right:6rpx}