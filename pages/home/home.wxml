<view class="landing">
  <view class="hero-stage">
    <image class="hero-image" src="./images/home-hero.jpg" mode="widthFix" />
    <view class="menu-layer">
      <view
        class="menu-cell"
        wx:for="{{menus}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onMenuTap"
        hover-class="menu-cell-hover"
        hover-stay-time="80"
      ></view>
    </view>
  </view>
</view>

<!-- 进小程序欢迎弹窗：社群二维码 -->
<view class="popup-mask" wx:if="{{showCommunityPopup}}" catchtouchmove="noop">
  <view class="popup-panel">
    <image
      class="popup-image"
      src="./images/community-popup.jpg"
      mode="widthFix"
      show-menu-by-longpress="{{true}}"
    />
    <view class="popup-close" bindtap="onCloseCommunityPopup" hover-class="popup-close-hover">
      <text class="popup-close-x">×</text>
    </view>
  </view>
</view>

<main-tab-bar current="home" />
