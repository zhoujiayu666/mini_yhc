page{background:#fafaf7;color:#20232a}.home{padding:0 28rpx 160rpx}.brand{display:flex;align-items:center;justify-content:space-between;padding:12rpx 6rpx 32rpx}.wordmark{display:block;font-size:46rpx;font-weight:800;letter-spacing:5rpx}.brand-caption{display:block;font-size:13rpx;letter-spacing:2rpx;margin-top:5rpx}.brand-note{font-size:22rpx;color:#787b80}.preview{display:flex;justify-content:space-between;background:#fff3c1;padding:20rpx;border-radius:14rpx;font-size:22rpx;margin-bottom:24rpx}.module{margin-bottom:24rpx;border-radius:24rpx;overflow:hidden;padding:30rpx}.banner{padding:0;color:white}.hero{height:100%;position:relative;overflow:hidden;background:#171b26}.cover{position:absolute;width:100%;height:100%;opacity:1}.hero-copy{position:relative;padding:52rpx 38rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#f6d976}.hero-title{display:block;white-space:pre-line;font-size:52rpx;font-weight:700;line-height:1.35;margin-top:30rpx;max-width:540rpx}.hero-detail{display:block;font-size:24rpx;margin-top:12rpx}.hero-action{display:inline-block;margin-top:32rpx;background:#ffd100;color:#171b26;padding:16rpx 28rpx;border-radius:40rpx;font-size:24rpx}.orb{position:absolute;right:-70rpx;bottom:-90rpx;width:400rpx;height:400rpx;border-radius:50%;background:radial-gradient(circle,#f9ec9c 0%,#d8a331 12%,#453c61 45%,#171b26 70%)}.heading{margin-bottom:26rpx}.title{display:block;font-size:34rpx;font-weight:700}.subtitle{display:block;font-size:23rpx;color:#7a7e83;margin-top:10rpx;line-height:1.6}.grid{display:flex;flex-wrap:wrap;justify-content:space-between}.tile{box-sizing:border-box;background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}.tile-title{display:block;font-size:26rpx;font-weight:600}.tile-image{width:100%;height:230rpx;border-radius:12rpx;margin-bottom:20rpx}.product-art{height:240rpx;background:#edeef0;border-radius:12rpx;margin-bottom:20rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#98999d;font-size:16rpx;letter-spacing:4rpx}.light-stick{height:140rpx;width:28rpx;border-radius:18rpx;background:linear-gradient(#fff6be,#e8c853 65%,#333 66%,#45484e);transform:rotate(25deg);margin-bottom:25rpx;box-shadow:0 0 22rpx #f9e898}.video-placeholder{background:#232c38;border-radius:16rpx;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:26rpx}.play{font-size:60rpx;color:#f2d571}.muted{font-size:22rpx;color:#aab0b8;margin-top:12rpx}video{width:100%;border-radius:16rpx}.poster-image{width:100%;border-radius:16rpx}.poster-link{display:block;margin-top:20rpx;font-size:26rpx}.about{color:#fff}.about .subtitle{color:#b6bdc8}.footer{text-align:center;padding:30rpx;font-size:20rpx;color:#92959a}

.dark{color:#fff}.dark .subtitle{color:#b6bdc8}.dark .tile{color:#24272c}.dark .tile .subtitle{color:#7a7e83}

.preview-actions{display:flex;justify-content:space-between;font-size:24rpx;color:#5376a7;padding:0 10rpx 24rpx}

.four-entries .tile{padding:0;background:transparent;border-radius:0;text-align:center}.four-entries .tile-image,.entry-placeholder{height:134rpx;width:100%;border-radius:6rpx;margin-bottom:16rpx}.entry-placeholder{background:#e9edf3;color:#9ba5b4;display:flex;align-items:center;justify-content:center;font-size:20rpx}.four-entries .tile-title{font-size:22rpx;font-weight:500;white-space:nowrap}.four-entries .subtitle{font-size:20rpx}

.banner>.heading{padding:30rpx 30rpx 0}.banner>.heading .subtitle{color:#b6bdc8}

.community-entries .tile{min-height:128rpx;display:flex;flex-direction:column;justify-content:center;text-align:center;border:1rpx solid #dfe4ed}

.home-product-grid{display:flex;flex-wrap:wrap;justify-content:space-between}.home-product{width:48%;margin-bottom:36rpx;color:#253047}.home-product>image,.home-product-placeholder{width:100%;height:300rpx;background:#eef0f4}.home-product-placeholder{display:flex;align-items:center;justify-content:center;color:#9aa5b4;font-size:24rpx}.home-product-name{display:block;font-size:24rpx;margin:16rpx 0;line-height:1.5}.home-product-purchase{display:flex;align-items:center;justify-content:space-between}.home-price{display:block;color:#c64129;font-size:28rpx}.home-original{display:block;text-decoration:line-through;font-size:20rpx;color:#8e97a6}.home-product-purchase button{font-size:20rpx;padding:0 8rpx;background:#fff3e8;color:#b95322;margin:0}

.floating-cart{position:fixed;z-index:110;right:28rpx;bottom:140rpx;bottom:calc(140rpx + env(safe-area-inset-bottom));width:94rpx;height:94rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff;box-shadow:0 6rpx 28rpx rgba(0,0,0,.18);border:1rpx solid #eee}.floating-cart-icon{font-size:48rpx;line-height:1}.floating-cart-count{position:absolute;right:-2rpx;top:-4rpx;min-width:34rpx;height:34rpx;padding:0 8rpx;box-sizing:border-box;border-radius:18rpx;background:#ef4444;color:#fff;font-size:21rpx;line-height:34rpx;text-align:center}
.cart-drawing{position:relative;width:52rpx;height:52rpx}.cart-handle{position:absolute;left:0;top:5rpx;width:12rpx;height:5rpx;background:#171b20;border-radius:3rpx}.cart-basket{position:absolute;left:11rpx;top:10rpx;width:36rpx;height:27rpx;border:4rpx solid #171b20;border-top-width:5rpx;border-radius:2rpx 2rpx 5rpx 5rpx;transform:skewX(-8deg);box-sizing:border-box}.cart-wheel{position:absolute;bottom:3rpx;width:7rpx;height:7rpx;border-radius:50%;background:#171b20}.cart-wheel-left{left:14rpx}.cart-wheel-right{right:6rpx}
.module.compact-links{padding:20rpx 28rpx}.compact-links .tile{min-height:0;padding:12rpx;margin-bottom:0}.compact-links .four-entries .tile{padding:0}.compact-links .tile-image{display:block;flex-shrink:0;margin-bottom:12rpx}.compact-links .tile-image:last-child{margin-bottom:0}.compact-links .entry-placeholder{overflow:hidden;font-size:20rpx}.compact-links .grid{row-gap:20rpx}

.module.adjacent-links-top{padding-top:4rpx}.module.adjacent-links-bottom{padding-bottom:4rpx}.adjacent-links-bottom>.grid{row-gap:16rpx}.adjacent-links-bottom>.grid>.tile{margin-bottom:0}.compact-links.adjacent-links-bottom>.grid{row-gap:20rpx}
