page {
  background: #05070f;
  color: #e8eef8;
}

.landing {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(ellipse 80% 50% at 50% 70%, rgba(255, 120, 40, 0.18), transparent 55%),
    radial-gradient(ellipse 70% 45% at 50% 20%, rgba(40, 70, 120, 0.35), transparent 60%),
    #05070f;
}

.hero-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.hero-image {
  display: block;
  width: 100%;
  vertical-align: top;
}

/* 覆盖设计稿底部 2×3 金属按钮区域 */
.menu-layer {
  position: absolute;
  left: 7%;
  right: 7%;
  bottom: 4.5%;
  height: 28%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
  gap: 3.2% 4%;
  z-index: 2;
}

.menu-cell {
  border-radius: 12rpx;
}

.menu-cell-hover {
  background: rgba(255, 220, 160, 0.08);
}

/* 进店社群弹窗 */
.popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 56rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.72);
}

.popup-panel {
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.popup-image {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.popup-close {
  margin-top: 36rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.popup-close-x {
  color: #fff;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 300;
}

.popup-close-hover {
  opacity: 0.7;
}
