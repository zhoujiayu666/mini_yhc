@import "../shop-common/shop-common.wxss";

.addr-card {
  padding-bottom: 20rpx;
}

.addr-default {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #C89600;
  background: #FFF8E1;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.addr-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 16rpx;
}

.addr-action {
  font-size: 26rpx;
  color: #757575;
}

.addr-action.danger {
  color: #F44336;
}

.bottom-bar.single {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.submit-btn.full {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.submit-btn.full::after {
  border: none;
}

.shop-page {
  padding-bottom: 160rpx;
}
