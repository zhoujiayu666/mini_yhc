<page-nav-bar back="{{true}}"></page-nav-bar>
<view wx:if="{{error || mediaError}}" class="load-error" bindtap="loadContent">{{error || '图片暂未加载，点击重试'}}</view>
<view wx:if="{{loading && !content}}" class="state">正在加载…</view>
<view wx:elif="{{content}}" class="content-page {{kind === 'product' ? 'with-redemption' : ''}}">
 <image wx:if="{{content.image}}" class="cover" src="{{content.image}}" mode="widthFix" data-src="{{content.image}}" bindtap="previewImage" binderror="onMediaError"/>
 <view class="article"><text class="title">{{content.title}}</text>
  <block wx:if="{{kind === 'product'}}"><text class="points">{{content.points}} 积分</text><text wx:if="{{content.description}}" class="text">{{content.description}}</text><block wx:if="{{content.exchangeInstructions}}"><text class="section-title">兑换说明</text><text class="text" user-select="{{true}}">{{content.exchangeInstructions}}</text></block><text class="redemption-orders-link" bindtap="orders">我的兑换订单 ›</text></block>
  <block wx:else><block wx:for="{{content.content}}" wx:key="id"><text wx:if="{{item.type === 'text'}}" class="text">{{item.text}}</text><image wx:elif="{{item.image}}" class="body-image" src="{{item.image}}" mode="widthFix" data-src="{{item.image}}" bindtap="previewImage" binderror="onMediaError"/></block></block>
 </view>
</view>
<button wx:elif="{{!loading}}" class="retry" bindtap="loadContent">重新加载</button>

<view wx:if="{{kind === 'product' && (content || hasPending)}}" class="redemption-footer"><view class="redemption-summary"><text class="redemption-price">{{quote ? quote.product.points : content.points}} 积分</text><text class="redemption-balance">{{hasPending ? '上次兑换结果待确认' : (quoteLoading ? '正在获取积分与库存…' : (quoteError || (loggedIn && quote && quote.isMember ? '可用积分：' + quote.points : '登录后查看可用积分')))}}</text></view><button bindtap="redeem" disabled="{{quoteLoading || (!quoteError && !canRedeem)}}">{{quoteLoading ? '加载中…' : buttonText}}</button></view>
