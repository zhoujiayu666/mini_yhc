page{background:#f6f6f6;color:#20232a}.content-page{padding-bottom:calc(60rpx + env(safe-area-inset-bottom))}.cover{display:block;width:100%;background:white}.article{display:block;background:#fff;margin:24rpx;padding:32rpx;border-radius:16rpx}.title{display:block;font-size:40rpx;font-weight:700;line-height:1.5;margin-bottom:24rpx;word-break:break-all}.points{display:block;font-size:34rpx;font-weight:600;color:#8b6c1c;margin-bottom:30rpx}.section-title{display:block;font-size:32rpx;font-weight:600;margin:36rpx 0 20rpx}.text{display:block;font-size:29rpx;line-height:1.9;white-space:pre-wrap;word-break:break-word;color:#4f5866;margin-bottom:22rpx}.body-image{display:block;width:100%;margin-bottom:24rpx}.state{padding:180rpx 30rpx;text-align:center;color:#959faa}.load-error{margin:24rpx;padding:24rpx;background:#fff4df;color:#956626;border-radius:8rpx;font-size:26rpx}.retry{font-size:28rpx;background:#f6d765;max-width:260rpx;margin:40rpx auto}.retry::after{border:0}

.with-redemption{padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}.redemption-footer{position:fixed;left:0;right:0;bottom:0;z-index:20;padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:18rpx;background:#fff;border-top:1px solid #eee}.redemption-summary{flex:1;min-width:0}.redemption-price{display:block;color:#8b6c1c;font-size:34rpx;font-weight:600}.redemption-balance{display:block;font-size:23rpx;color:#888;line-height:1.5;margin-top:6rpx}.redemption-footer button{margin:0;flex-shrink:0;min-width:290rpx;max-width:380rpx;padding:0 25rpx;background:#f5d76e;color:#27231b;line-height:88rpx;font-size:29rpx;border-radius:999rpx;font-weight:600}.redemption-footer button::after{border:0}.redemption-footer button[disabled]{background:#e8e8e8;color:#999}.redemption-orders-link{display:block;color:#89702b;font-size:28rpx;margin-top:30rpx}
