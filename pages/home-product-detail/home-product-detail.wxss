page{background:#f5f5f7;color:#20232a}.detail-page{padding-bottom:150rpx}.main-swiper{height:750rpx;background:#fff}.main-image{display:block;width:100%;height:750rpx;background:#fff}.image-placeholder{height:750rpx;display:flex;align-items:center;justify-content:center;background:#eceff3;color:#9ba5b4;font-size:28rpx}.title-card,.detail-card{margin:20rpx 24rpx 0;padding:30rpx;background:#fff;border-radius:20rpx}.product-title{display:block;font-size:38rpx;font-weight:700;line-height:1.45}.price-row{display:flex;align-items:baseline;gap:18rpx;margin-top:22rpx}.price{font-size:42rpx;font-weight:700;color:#d64b2a}.original{font-size:25rpx;color:#a7adb6;text-decoration:line-through}.section-title{display:block;font-size:31rpx;font-weight:650;margin-bottom:22rpx}.detail-text{display:block;font-size:28rpx;color:#5f6672;line-height:1.8;white-space:pre-wrap}.detail-block-text{margin:18rpx 0}.detail-block-image{display:block;width:100%;margin:18rpx 0;border-radius:12rpx}.empty{padding:240rpx 30rpx;text-align:center;color:#969da8}.bottom-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;gap:16rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -4rpx 22rpx rgba(0,0,0,.07)}.bottom-bar button{flex:1;height:88rpx;margin:0;padding:0;border-radius:44rpx;font-size:30rpx;font-weight:650;line-height:normal;display:flex;align-items:center;justify-content:center;text-align:center}.bottom-bar button::after{border:0}
.cart-button{background:#fff4c2!important;color:#7a5700!important}.buy-button{background:#ffd100!important;color:#20232a!important}
.main-gallery{position:relative;width:100%;overflow:hidden;background:#fff}.main-gallery .main-swiper,.main-gallery .main-image{width:100%;height:750rpx}.gallery-arrow{position:absolute;z-index:1;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:68rpx;height:88rpx;margin:0;padding:0;border-radius:44rpx;background:rgba(0,0,0,.38);color:#fff;font-size:60rpx;line-height:1}.gallery-arrow::after{border:0}.gallery-prev{left:20rpx}.gallery-next{right:20rpx}.gallery-position{position:absolute;left:0;right:0;bottom:24rpx;display:flex;justify-content:space-between;align-items:center;padding:0 26rpx;pointer-events:none}.gallery-position text{padding:8rpx 18rpx;border-radius:30rpx;background:rgba(0,0,0,.5);color:#fff;font-size:22rpx;line-height:1.4}
