page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.software-page {
  padding: 24rpx 40rpx 48rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 48rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFFFFF 100%);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #C89600;
  background: rgba(255, 209, 0, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  line-height: 1.35;
  word-break: break-all;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #757575;
}

.info-card,
.tip-card {
  padding: 32rpx 36rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.info-label {
  display: block;
  font-size: 26rpx;
  color: #9E9E9E;
  margin-bottom: 16rpx;
}

.info-desc {
  font-size: 28rpx;
  color: #424242;
  line-height: 1.7;
}

.tip-text {
  font-size: 26rpx;
  color: #9E9E9E;
  line-height: 1.6;
}
