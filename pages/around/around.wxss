page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.shop-page {
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(100rpx + env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.refresh-hint {
  font-size: 22rpx;
  color: #B0B0B0;
  flex-shrink: 0;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #9E9E9E;
}

.cloud-error-banner {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #FFF8E6;
  border: 1rpx solid #FFE0A3;
  border-radius: 16rpx;
}

.cloud-error-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8A5A00;
}

.cloud-error-retry {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  background: #FF9800;
  border-radius: 999rpx;
}

.category-section {
  position: relative;
  z-index: 10;
  width: 100%;
  min-height: 72rpx;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}

.category-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 16rpx;
  padding: 4rpx 0;
}

.category-chip {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #757575;
  background: #F7F7F8;
}

.category-chip.active {
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  color: #1A1A1A;
  font-weight: 600;
}

.product-grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
  margin-top: 0;
}

.product-card {
  width: calc(50% - 12rpx);
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
}

.product-visual {
  position: relative;
  height: 280rpx;
  background: #1A1A1A;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.product-visual.stick {
  background: linear-gradient(165deg, #08080c 0%, #15151c 45%, #0a0a10 100%);
}

.detail-visual.stick {
  background: linear-gradient(165deg, #08080c 0%, #15151c 45%, #0a0a10 100%);
}

.glow-bg {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  opacity: 0.35;
  filter: blur(40rpx);
}

.glow-bg.large {
  width: 320rpx;
  height: 320rpx;
}

/* 荧光棒 */
.stick-fig {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stick-bloom {
  position: absolute;
  width: 100rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--c);
  opacity: 0.55;
  transform: rotate(18deg);
  z-index: 1;
}

.stick-bloom-soft {
  width: 160rpx;
  height: 260rpx;
  opacity: 0.22;
  z-index: 0;
}

.stick-assembly {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: rotate(18deg);
}

.stick-hook {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 50%;
  margin-bottom: 6rpx;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.2);
}

.stick-cap {
  width: 34rpx;
  height: 14rpx;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  background: linear-gradient(180deg, #5a5a5a 0%, #2e2e2e 100%);
  margin-bottom: -2rpx;
}

.stick-tube {
  position: relative;
  width: 32rpx;
  height: 148rpx;
  border-radius: 16rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.15) 0%,
    var(--c) 28%,
    var(--c) 72%,
    rgba(0, 0, 0, 0.22) 100%
  );
  box-shadow:
    0 0 16rpx var(--c),
    0 0 40rpx var(--c),
    inset 0 0 18rpx rgba(255, 255, 255, 0.35);
  overflow: hidden;
}

.stick-tube-glow {
  position: absolute;
  left: 6rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: 10rpx;
  border-radius: 5rpx;
  background: rgba(255, 255, 255, 0.55);
}

.stick-tube-shine {
  position: absolute;
  right: 5rpx;
  top: 16rpx;
  width: 6rpx;
  height: 72rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.28);
}

.stick-connector {
  width: 28rpx;
  height: 8rpx;
  background: linear-gradient(180deg, #3a3a3a 0%, #222 100%);
  margin-top: -2rpx;
}

.stick-handle {
  width: 40rpx;
  height: 46rpx;
  border-radius: 4rpx 4rpx 12rpx 12rpx;
  background: linear-gradient(180deg, #4d4d4d 0%, #1f1f1f 55%, #141414 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.08);
}

.stick-grip-line {
  width: 26rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* 详情大图 */
.stick-fig.large .stick-bloom {
  width: 140rpx;
  height: 280rpx;
}

.stick-fig.large .stick-bloom-soft {
  width: 220rpx;
  height: 340rpx;
}

.stick-fig.large .stick-hook {
  width: 26rpx;
  height: 26rpx;
  border-width: 4rpx;
}

.stick-fig.large .stick-cap {
  width: 48rpx;
  height: 18rpx;
}

.stick-fig.large .stick-tube {
  width: 46rpx;
  height: 220rpx;
  border-radius: 23rpx;
}

.stick-fig.large .stick-tube-glow {
  left: 9rpx;
  width: 14rpx;
}

.stick-fig.large .stick-tube-shine {
  right: 8rpx;
  height: 110rpx;
}

.stick-fig.large .stick-connector {
  width: 40rpx;
  height: 10rpx;
}

.stick-fig.large .stick-handle {
  width: 56rpx;
  height: 64rpx;
}

.stick-fig.large .stick-grip-line {
  width: 36rpx;
}

/* 发光球 */
.ball-sphere {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
}

.ball-sphere.large {
  width: 180rpx;
  height: 180rpx;
}

.ball-shine {
  position: absolute;
  width: 36rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  top: calc(50% - 44rpx);
  left: calc(50% - 20rpx);
  z-index: 3;
  transform: rotate(-30deg);
}

.ball-shine.large {
  width: 52rpx;
  height: 28rpx;
  top: calc(50% - 66rpx);
  left: calc(50% - 28rpx);
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 4;
  font-size: 20rpx;
  color: #1A1A1A;
  background: #FFD100;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.product-info {
  padding: 20rpx 20rpx 24rpx;
}

.product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  display: block;
  font-size: 22rpx;
  color: #9E9E9E;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.add-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  color: #1A1A1A;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 详情弹层 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}

.detail-sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
  padding-right: 16rpx;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F7F7F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #757575;
  line-height: 1;
}

.detail-visual {
  position: relative;
  height: 360rpx;
  background: #1A1A1A;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.detail-desc {
  display: block;
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 12rpx;
}

.detail-price {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.detail-note {
  display: block;
  font-size: 24rpx;
  color: #9E9E9E;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
}

.detail-cart,
.detail-buy {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0;
  padding: 0;
}

.detail-cart {
  background: #F7F7F8;
  color: #1A1A1A;
}

.detail-buy {
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  color: #1A1A1A;
}

.detail-cart::after,
.detail-buy::after {
  border: none;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
}

.skeleton-card {
  width: calc(50% - 12rpx);
  padding: 20rpx;
  border-radius: 24rpx;
  background: #FAFAFA;
  box-sizing: border-box;
}

.skeleton-visual {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.2s ease-in-out infinite;
  margin-bottom: 20rpx;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.2s ease-in-out infinite;
  margin-bottom: 12rpx;
}

.skeleton-line-title {
  width: 80%;
  height: 28rpx;
}

.skeleton-line-desc {
  width: 60%;
}

.skeleton-line-price {
  width: 40%;
  margin-bottom: 0;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
