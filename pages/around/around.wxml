<page-nav-bar>
  <view slot="right" class="cart-btn" bindtap="onCartTap">
    <text class="cart-icon">🛒</text>
    <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
  </view>
</page-nav-bar>
<scroll-view class="scrollarea" scroll-y>
  <view class="shop-page">
    <view class="page-header">
      <text class="page-title">周边商城</text>
      <text class="page-subtitle">荧光棒 · 发光球 · 演示商品</text>
    </view>

    <view class="category-section">
      <view class="category-row">
        <view
          class="category-chip {{activeCategory === item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onCategoryTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="product-grid">
      <view
        class="product-card"
        wx:for="{{displayProducts}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onProductTap"
      >
        <view class="product-visual {{item.category}}">
          <view class="glow-bg" wx:if="{{item.category === 'ball'}}" style="background: {{item.color}};"></view>
          <block wx:if="{{item.category === 'stick'}}">
            <view class="stick-fig" style="--c: {{item.color}};">
              <view class="stick-bloom"></view>
              <view class="stick-bloom stick-bloom-soft"></view>
              <view class="stick-assembly">
                <view class="stick-hook"></view>
                <view class="stick-cap"></view>
                <view class="stick-tube">
                  <view class="stick-tube-glow"></view>
                  <view class="stick-tube-shine"></view>
                </view>
                <view class="stick-connector"></view>
                <view class="stick-handle">
                  <view class="stick-grip-line"></view>
                  <view class="stick-grip-line"></view>
                  <view class="stick-grip-line"></view>
                </view>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="ball-sphere" style="background: radial-gradient(circle at 35% 30%, #FFFFFF 0%, {{item.color}} 45%, rgba(0,0,0,0.15) 100%);"></view>
            <view class="ball-shine"></view>
          </block>
          <text class="product-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc">{{item.desc}}</text>
          <view class="product-bottom">
            <text class="product-price">¥{{item.price}}</text>
            <view class="add-btn" catchtap="addToCart" data-id="{{item.id}}">+</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>

<view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
  <view class="detail-sheet" catchtap="stopPropagation">
    <view class="detail-header">
      <text class="detail-title">{{detailProduct.name}}</text>
      <view class="detail-close" bindtap="closeDetail">×</view>
    </view>
    <view class="detail-visual {{detailProduct.category}}">
      <view class="glow-bg large" wx:if="{{detailProduct.category === 'ball'}}" style="background: {{detailProduct.color}};"></view>
      <block wx:if="{{detailProduct.category === 'stick'}}">
        <view class="stick-fig large" style="--c: {{detailProduct.color}};">
          <view class="stick-bloom"></view>
          <view class="stick-bloom stick-bloom-soft"></view>
          <view class="stick-assembly">
            <view class="stick-hook"></view>
            <view class="stick-cap"></view>
            <view class="stick-tube">
              <view class="stick-tube-glow"></view>
              <view class="stick-tube-shine"></view>
            </view>
            <view class="stick-connector"></view>
            <view class="stick-handle">
              <view class="stick-grip-line"></view>
              <view class="stick-grip-line"></view>
              <view class="stick-grip-line"></view>
            </view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="ball-sphere large" style="background: radial-gradient(circle at 35% 30%, #FFFFFF 0%, {{detailProduct.color}} 45%, rgba(0,0,0,0.15) 100%);"></view>
        <view class="ball-shine large"></view>
      </block>
    </view>
    <text class="detail-desc">{{detailProduct.desc}}</text>
    <text class="detail-price">¥{{detailProduct.price}}</text>
    <text class="detail-note">本页面为演示商城，商品信息仅供展示，暂不支持真实下单。</text>
    <button class="detail-buy" bindtap="addToCart" data-id="{{detailProduct.id}}">加入购物车</button>
  </view>
</view>

<main-tab-bar current="around"></main-tab-bar>
