<page-nav-bar back="{{true}}"></page-nav-bar>
<scroll-view class="scrollarea" scroll-y>
  <view class="shop-page" wx:if="{{order}}">
    <view class="section-card status-card">
      <text class="status-title">{{order.statusLabel}}</text>
      <text class="status-sub">{{order.logisticsLabel}}</text>
    </view>

    <view class="section-card" wx:if="{{order.status !== 'pending_pay' && order.status !== 'cancelled'}}">
      <view class="logistics-head">
        <text class="section-title">物流状态</text>
        <text class="copy-track" wx:if="{{order.trackingNo}}" catchtap="onCopyTracking">复制单号</text>
      </view>
      <view class="logistics-track" wx:if="{{order.trackingNo}}">
        <text>{{order.expressCompany || '快递'}}</text>
        <text>{{order.trackingNo}}</text>
      </view>
      <text class="logistics-empty" wx:else>商家发货后将在此显示快递公司和运单号</text>
      <view class="trace-list" wx:if="{{order.traces.length}}">
        <view class="trace-item" wx:for="{{order.traces}}" wx:key="index">
          <text class="trace-time" wx:if="{{item.time}}">{{item.time}}</text>
          <text class="trace-desc">{{item.desc}}</text>
        </view>
      </view>
      <text class="trace-desc latest" wx:elif="{{order.logisticsDesc}}">{{order.logisticsDesc}}</text>
      <view class="logistics-steps">
        <view
          class="logistics-step {{item.done ? 'done' : ''}}"
          wx:for="{{order.steps}}"
          wx:key="id"
        >
          <view class="step-dot"></view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="section-card" wx:if="{{order.addressText}}">
      <text class="section-title">收货信息</text>
      <text class="addr-line">{{order.contactText}}</text>
      <text class="addr-line muted">{{order.addressText}}</text>
    </view>

    <view class="section-card">
      <text class="section-title">商品明细</text>
      <view class="line-item" wx:for="{{order.itemLines}}" wx:key="sku">
        <view class="line-main">
          <text class="line-name">{{item.name}}</text>
          <text class="line-qty">×{{item.qty}}</text>
        </view>
        <text class="line-price">¥{{item.lineYuan}}</text>
      </view>
      <view class="summary-row total">
        <text>实付</text>
        <text class="pay-amount">¥{{order.payYuan}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">订单信息</text>
      <view class="info-row"><text>订单号</text><text>{{order.orderNo}}</text></view>
      <view class="info-row"><text>下单时间</text><text>{{order.createdText}}</text></view>
      <view class="info-row" wx:if="{{order.paidText}}"><text>支付时间</text><text>{{order.paidText}}</text></view>
      <view class="info-row" wx:if="{{order.shippedText}}"><text>发货时间</text><text>{{order.shippedText}}</text></view>
      <view class="info-row" wx:if="{{order.remark}}"><text>备注</text><text>{{order.remark}}</text></view>
    </view>
  </view>
</scroll-view>

<view class="bottom-bar" wx:if="{{order}}">
  <button class="btn-outline" wx:if="{{order.status === 'pending_pay'}}" bindtap="onCancel">取消订单</button>
  <button class="btn-primary" wx:if="{{order.status === 'pending_pay'}}" loading="{{acting}}" disabled="{{acting}}" bindtap="onPayTap">去支付</button>
  <button class="btn-primary" wx:if="{{order.status === 'shipped'}}" bindtap="onConfirmReceive">确认收货</button>
  <button class="btn-outline danger" wx:if="{{order.status === 'completed' || order.status === 'cancelled'}}" bindtap="onDelete">删除订单</button>
</view>
