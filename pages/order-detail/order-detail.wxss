@import "../shop-common/shop-common.wxss";
@import "../checkout/checkout.wxss";

.status-card {
  text-align: center;
  padding: 40rpx 28rpx;
}

.status-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.status-sub {
  font-size: 26rpx;
  color: #9E9E9E;
}

.addr-line {
  display: block;
  font-size: 28rpx;
  color: #424242;
  line-height: 1.6;
}

.addr-line.muted {
  color: #757575;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 26rpx;
  color: #757575;
  padding: 10rpx 0;
}

.info-row text:last-child {
  color: #424242;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.shop-page {
  padding-bottom: 160rpx;
}
