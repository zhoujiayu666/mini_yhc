@import "../shop-common/shop-common.wxss";
@import "../checkout/checkout.wxss";

.status-card {
  text-align: center;
  padding: 40rpx 28rpx;
}

.status-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.status-sub {
  font-size: 26rpx;
  color: #9E9E9E;
}

.logistics-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.logistics-head .section-title {
  margin-bottom: 0;
}

.copy-track {
  font-size: 24rpx;
  color: #C89600;
}

.logistics-track {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 12rpx 0 20rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  word-break: break-all;
}

.logistics-empty {
  display: block;
  margin: 8rpx 0 20rpx;
  font-size: 26rpx;
  color: #9E9E9E;
}

.trace-list {
  margin: 8rpx 0 24rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid #FFE566;
}

.trace-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 0 12rpx 20rpx;
}

.trace-time {
  font-size: 22rpx;
  color: #9E9E9E;
}

.trace-desc {
  font-size: 24rpx;
  color: #424242;
  line-height: 1.5;
}

.trace-desc.latest {
  display: block;
  margin: 8rpx 0 20rpx;
  font-size: 24rpx;
  color: #424242;
  line-height: 1.5;
}

.logistics-steps {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}

.logistics-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #BDBDBD;
}

.logistics-step .step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E0E0E0;
}

.logistics-step.done {
  color: #C89600;
}

.logistics-step.done .step-dot {
  background: #FFD100;
}

.addr-line {
  display: block;
  font-size: 28rpx;
  color: #424242;
  line-height: 1.6;
}

.addr-line.muted {
  color: #757575;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 26rpx;
  color: #757575;
  padding: 10rpx 0;
}

.info-row text:last-child {
  color: #424242;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.btn-outline.danger {
  color: #F44336;
  border-color: #FFCDD2;
  background: #FFF5F5;
}

.bottom-bar button {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 28rpx;
}
