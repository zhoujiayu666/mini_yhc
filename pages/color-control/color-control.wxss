/**color-control.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.container {
  padding: calc(env(safe-area-inset-top) + 24rpx) 40rpx calc(88rpx + env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 36rpx;
}

.page-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-label,
.slider-label {
  display: block;
  font-size: 26rpx;
  color: #9E9E9E;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

/* 电源卡片 */
.power-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.power-info {
  display: flex;
  flex-direction: column;
}

.power-status {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.power-desc {
  font-size: 26rpx;
  color: #9E9E9E;
}

.power-switch {
  transform: scale(0.92);
}

/* 模式行 */
.mode-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 8rpx 0;
}

.mode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.mode-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

/* 模式图标 PNG */
.mode-icon-img {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.mode-icon-img.is-dim {
  opacity: 0.4;
}

.mode-name {
  font-size: 22rpx;
  color: #757575;
  text-align: center;
}

.mode-item.disabled .mode-name {
  color: #BDBDBD;
}

.mode-item.active .mode-name {
  color: #1A1A1A;
  font-weight: 600;
}

/* 色轮 */
.color-wheel-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 0 8rpx;
}

.is-powered-off .color-wheel-section {
  opacity: 0.4;
  pointer-events: none;
}

/* 滑块 */
.slider-section {
  padding-right: 8rpx;
}

.plain-slider {
  margin: 0;
  width: 100%;
}
