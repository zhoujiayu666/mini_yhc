@import "../shop-common/shop-common.wxss";

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.paste-card {
  padding: 24rpx 28rpx 20rpx;
}

.paste-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.paste-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.paste-action {
  font-size: 26rpx;
  color: #C89600;
}

.paste-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 0 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1A1A1A;
}

.locate-btn {
  margin: 0 0 20rpx;
  padding: 0 28rpx;
  height: 96rpx;
  background: #FFFFFF;
  color: #1A1A1A;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  line-height: normal;
}

.locate-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.locate-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.locate-sub {
  font-size: 22rpx;
  color: #8A8A8A;
}

.locate-btn.is-loading {
  opacity: 0.55;
}

.locate-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.locate-ring {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 3rpx solid #1A1A1A;
  border-radius: 50%;
  box-sizing: border-box;
}

.locate-cross {
  position: absolute;
  background: #1A1A1A;
}

.locate-h {
  left: -4rpx;
  right: -4rpx;
  top: 50%;
  height: 3rpx;
  margin-top: -1.5rpx;
}

.locate-v {
  top: -4rpx;
  bottom: -4rpx;
  left: 50%;
  width: 3rpx;
  margin-left: -1.5rpx;
}

.locate-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: -4rpx 0 0 -4rpx;
  border-radius: 50%;
  background: #1A1A1A;
}

.shop-page {
  padding-bottom: 160rpx;
}

.bottom-bar.single {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
}

.submit-btn.full {
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  color: #1A1A1A;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: normal;
  font-size: 30rpx;
}

.submit-btn.full::after {
  border: none;
}
