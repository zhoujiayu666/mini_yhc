@import "../shop-common/shop-common.wxss";

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.paste-card {
  padding: 24rpx 28rpx 20rpx;
}

.paste-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.paste-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.paste-action {
  font-size: 26rpx;
  color: #C89600;
}

.paste-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 0 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1A1A1A;
}

.wx-addr-btn {
  margin-top: 8rpx;
  background: #FFFFFF;
  color: #424242;
  font-size: 28rpx;
  border-radius: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.wx-addr-btn::after {
  border: none;
}

.shop-page {
  padding-bottom: 160rpx;
}

.bottom-bar.single {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
}

.submit-btn.full {
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  color: #1A1A1A;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: normal;
  font-size: 30rpx;
}

.submit-btn.full::after {
  border: none;
}
