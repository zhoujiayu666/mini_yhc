page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.legal-page {
  padding: 32rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.legal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.legal-updated {
  display: block;
  font-size: 24rpx;
  color: #9e9e9e;
  margin-bottom: 40rpx;
}

.legal-section {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin: 28rpx 0 12rpx;
}

.legal-p {
  display: block;
  font-size: 28rpx;
  color: #616161;
  line-height: 1.75;
}
