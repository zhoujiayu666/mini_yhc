/**settings.wxss**/

page {

  height: 100vh;

  display: flex;

  flex-direction: column;

  background-color: var(--page-bg);

}



.scrollarea {

  flex: 1;

  min-height: 0;

  height: 0;

  padding-bottom: 0;

}



.container {

  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));

}



.logo-container {

  display: flex;

  align-items: center;

  padding-left: 32rpx;

}



.logo-icon {

  width: 48rpx;

  height: 48rpx;

  margin-right: 16rpx;

}



.settings-section {

  margin: 0 0 24rpx;

  padding: 28rpx 32rpx;

}



.section-title {

  font-size: 24rpx;

  font-weight: 600;

  color: var(--text-tertiary);

  text-transform: uppercase;

  letter-spacing: 2rpx;

  margin-bottom: 20rpx;

}



.settings-item {

  display: flex;

  justify-content: space-between;

  align-items: center;

  padding: 22rpx 0;

  border-bottom: 1rpx solid var(--border-color);

}



.settings-item:last-child {

  border-bottom: none;

}



.settings-left {

  display: flex;

  align-items: center;

  flex: 1;

  min-width: 0;

}



.settings-item.clickable:active {

  opacity: 0.7;

}



.settings-label {

  font-size: 28rpx;

  color: var(--text-primary);

  font-weight: 500;

}



.settings-value {

  font-size: 28rpx;

  color: var(--text-secondary);

  max-width: 50%;

  text-align: right;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

}



.settings-arrow {

  font-size: 40rpx;

  color: var(--text-tertiary);

  line-height: 1;

  font-weight: 300;

}


