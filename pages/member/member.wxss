page{background:#fafafa;color:#20232a}.member-page{padding:0 28rpx 140rpx;padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}.member-heading{text-align:center;font-size:36rpx;font-weight:600;padding:12rpx 0 28rpx}.section{margin-bottom:28rpx}.poster{display:block;width:100%;border-radius:8rpx;background:#f0f1f3}.entry-grid,.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.entry{min-width:0}.entry image{display:block;width:100%;border-radius:8rpx;background:#f0f1f3}.products-heading{display:block;font-size:32rpx;font-weight:600;margin-bottom:24rpx}.product-grid{row-gap:32rpx}.product{min-width:0;background:white;border-radius:8rpx;overflow:hidden}.product-image{width:100%;height:337rpx;display:block;background:#f0f1f3}.product-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all;line-height:1.6;font-size:26rpx;min-height:84rpx;margin:14rpx 10rpx}.product-bottom{display:flex;align-items:center;justify-content:space-between;padding:0 10rpx 16rpx}.points{flex:1;min-width:0;padding:6rpx 14rpx;margin-right:12rpx;background:#fff4cc;border-radius:999rpx;line-height:1}.points-num{font-size:28rpx;font-weight:700;color:#d4a017}.points-unit{margin-left:4rpx;font-size:18rpx;font-weight:500;color:#b08938}.exchange{margin:0;flex:none;width:auto!important;min-width:0;min-height:0;height:48rpx;padding:0 18rpx;font-size:20rpx;font-weight:600;line-height:48rpx;background:#f6d765;color:#3a3218;border-radius:999rpx}.exchange::after,.retry::after{border:0}.state{padding:160rpx 24rpx;text-align:center;color:#8e96a2;font-size:28rpx;line-height:2}.state text{display:block}.state-title{font-size:34rpx;color:#4a515b;margin-bottom:16rpx}.load-error{background:#fff4df;color:#956626;border-radius:8rpx;padding:20rpx 24rpx;margin-bottom:24rpx;font-size:26rpx;line-height:1.6}.retry{font-size:28rpx;background:#f6d765;max-width:260rpx;margin:30rpx auto}
