/**index.wxss**/

page {

  height: 100vh;

  display: flex;

  flex-direction: column;

  background-color: var(--page-bg);

}



.scrollarea {

  flex: 1;

  min-height: 0;

  height: 0;

  padding-bottom: 0;

}



.container {

  padding: 24rpx 32rpx 32rpx;

}



.logo-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.brand-logo {
  width: 200rpx;
  height: 56rpx;
  display: block;
}



.help-q {

  font-size: 28rpx;

  color: var(--text-secondary);

  font-weight: 600;

  line-height: 1;

}



/* 欢迎区 */

.hero-section {

  margin-bottom: 28rpx;

  padding: 8rpx 4rpx;

}



.hero-title {

  display: block;

  font-size: 40rpx;

  font-weight: 700;

  color: var(--text-primary);

  margin-bottom: 8rpx;

}



.hero-subtitle {

  display: block;

  font-size: 26rpx;

  color: var(--text-secondary);

}



/* 设备状态卡片 */

.status-card {

  margin: 0 0 28rpx;

  padding: 28rpx;

}



.status-header {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 20rpx;

}



.status-indicator {

  display: flex;

  align-items: center;

  flex: 1;

  min-width: 0;

}



.status-dot {

  width: 18rpx;

  height: 18rpx;

  border-radius: 50%;

  background-color: var(--text-tertiary);

  margin-right: 14rpx;

  flex-shrink: 0;

}



.status-dot.connected {

  background-color: var(--success-green);

  box-shadow: 0 0 12rpx rgba(76, 175, 80, 0.6);

  animation: pulse 2s infinite;

}



@keyframes pulse {

  0%, 100% { opacity: 1; transform: scale(1); }

  50% { opacity: 0.7; transform: scale(0.92); }

}



.status-text-group {

  display: flex;

  flex-direction: column;

  min-width: 0;

}



.status-text {

  font-size: 30rpx;

  color: var(--text-primary);

  font-weight: 600;

}



.mode-text {

  font-size: 22rpx;

  color: var(--text-secondary);

  margin-top: 4rpx;

}



.status-preview {

  width: 64rpx;

  height: 64rpx;

  border-radius: 50%;

  border: 3rpx solid rgba(255, 255, 255, 0.8);

  flex-shrink: 0;

  margin-left: 16rpx;

}



.status-footer {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 16rpx;

}



.status-info {

  flex: 1;

  min-width: 0;

}



.current-device-name {

  font-size: 24rpx;

  color: var(--text-secondary);

  display: block;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

}



.current-device-name.placeholder {

  color: var(--text-tertiary);

}



.status-action {

  padding: 12rpx 24rpx;

  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);

  border-radius: var(--radius-sm);

  box-shadow: 0 4rpx 12rpx var(--brand-yellow-glow);

  flex-shrink: 0;

}



.action-text {

  font-size: 24rpx;

  color: var(--bg-black);

  font-weight: 600;

}



/* 设备列表 */

.device-item {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 24rpx;

  margin-bottom: 16rpx;

  background-color: var(--card-bg);

  border-radius: var(--radius-md);

  border: 2rpx solid transparent;

  transition: border-color 0.25s, background 0.25s;

}



.device-item:active {

  border-color: var(--brand-yellow);

  background: var(--brand-yellow-light);

}



.device-info {

  flex: 1;

  display: flex;

  flex-direction: column;

  min-width: 0;

}



.device-name-row {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 12rpx;

  margin-bottom: 10rpx;

}



.device-item-name {

  font-size: 28rpx;

  color: var(--text-primary);

  font-weight: 500;

}



.device-connected-tag {

  font-size: 20rpx;

  color: var(--brand-yellow-text);

  background: var(--brand-yellow-light);

  padding: 4rpx 12rpx;

  border-radius: 8rpx;

  flex-shrink: 0;

}



.signal-bar {

  width: 120rpx;

  height: 6rpx;

  background: var(--surface-subtle);

  border-radius: 3rpx;

  overflow: hidden;

}



.signal-fill {

  height: 100%;

  background: linear-gradient(90deg, var(--brand-yellow) 0%, var(--success-green) 100%);

  border-radius: 3rpx;

  transition: width 0.3s;

}



.device-rssi {

  margin-left: 16rpx;

  flex-shrink: 0;

}



.rssi-text {

  font-size: 22rpx;

  color: var(--text-tertiary);

}



.scanning-pulse {

  animation: pulse 1.5s infinite;

}



/* 功能入口区 */

.function-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 20rpx;

  margin-bottom: 20rpx;

}



.function-card {

  margin: 0;

  display: flex;

  flex-direction: column;

  align-items: center;

  padding: 36rpx 24rpx;

  transition: transform 0.25s ease, box-shadow 0.25s ease;

}



.function-card:active {

  transform: scale(0.97);

  box-shadow: var(--shadow-md);

}



.function-card-wide {

  flex-direction: row;

  align-items: center;

  justify-content: space-between;

  padding: 28rpx 32rpx;

}



.function-wide-left {

  display: flex;

  align-items: center;

  flex: 1;

  min-width: 0;

}



.function-wide-text {

  display: flex;

  flex-direction: column;

  min-width: 0;

}



.function-arrow {

  font-size: 48rpx;

  color: var(--text-tertiary);

  line-height: 1;

  flex-shrink: 0;

  margin-left: 16rpx;

}



.function-icon-wrap {

  width: 120rpx;

  height: 120rpx;

  border-radius: 50%;

  background: var(--brand-yellow-soft);

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 20rpx;

}



.function-icon-wrap.music {

  background: rgba(255, 209, 0, 0.1);

}



.function-icon-wrap.group {

  width: 96rpx;

  height: 96rpx;

  margin-bottom: 0;

  margin-right: 20rpx;

  flex-shrink: 0;

}



.function-icon {

  display: flex;

  align-items: center;

  justify-content: center;

}



.function-title {

  font-size: 30rpx;

  font-weight: 600;

  color: var(--text-primary);

  margin-bottom: 6rpx;

}



.function-desc {

  font-size: 24rpx;

  color: var(--text-secondary);

}


