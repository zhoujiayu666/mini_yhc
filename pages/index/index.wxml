<!--pages/index/index.wxml-->

<navigation-bar title="" back="{{false}}" color="#212121" background="#FFFFFF">

  <view slot="center" class="logo-container">
    <image
      class="brand-logo"
      src="{{brandLogoSrc}}"
      mode="aspectFit"
      show-menu-by-longpress="{{false}}"
    />
  </view>

  <view slot="right" class="help-btn" bindtap="showHelp">

    <view class="help-btn-icon">

      <text class="help-q">?</text>

    </view>

  </view>

</navigation-bar>



<scroll-view class="scrollarea" scroll-y>

  <view class="container page-ambient">

    <!-- 欢迎区 -->

    <view class="hero-section">

      <text class="hero-title">智能荧光棒</text>

      <text class="hero-subtitle">连接设备，随心调光与律动</text>

    </view>



    <!-- 设备状态卡片 -->

    <view class="status-card card card-elevated" bindtap="openConnectGuide">

      <view class="status-header">

        <view class="status-indicator">

          <view class="status-dot {{isConnected ? 'connected' : ''}}"></view>

          <view class="status-text-group">

            <text class="status-text">{{deviceStatus}}</text>

            <text class="mode-text">{{controlMode}}</text>

          </view>

        </view>

        <view class="status-preview" style="background: hsl({{previewHue}}, {{previewSaturation}}%, {{previewBrightness}}%); box-shadow: 0 0 20rpx hsla({{previewHue}}, {{previewSaturation}}%, {{previewBrightness}}%, 0.5);"></view>

      </view>

      <view class="status-footer">

        <view class="status-info">

          <text class="current-device-name" wx:if="{{currentDevice}}">{{currentDevice.name || currentDevice.deviceId}}</text>

          <text class="current-device-name placeholder" wx:else>点击搜索并连接设备</text>

        </view>

        <view class="status-action">

          <text class="action-text">{{isConnected ? '选择设备' : '搜索设备'}}</text>

        </view>

      </view>

    </view>



    <!-- 功能入口区 -->

    <view class="function-grid">

      <view class="function-card card" bindtap="navigateToColorControl">

        <view class="function-icon-wrap">

          <view class="function-icon">

            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">

              <circle cx="12" cy="12" r="10" stroke="#FFD100" stroke-width="2" fill="#FFD100" fill-opacity="0.2"/>

              <circle cx="12" cy="12" r="6" fill="#FFD100"/>

              <path d="M12 2V6M12 18V22M2 12H6M18 12H22" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/>

            </svg>

          </view>

        </view>

        <text class="function-title">智能调光</text>

        <text class="function-desc">亮度 {{brightness}}%</text>

      </view>



      <view class="function-card card" bindtap="navigateToMusicRhythm">

        <view class="function-icon-wrap music">

          <view class="function-icon">

            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">

              <path d="M9 18V5L21 3V16" stroke="#FFD100" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>

              <circle cx="6" cy="18" r="3" stroke="#FFD100" stroke-width="2"/>

              <circle cx="18" cy="16" r="3" stroke="#FFD100" stroke-width="2"/>

            </svg>

          </view>

        </view>

        <text class="function-title">音乐律动</text>

        <text class="function-desc">{{musicRhythmEnabled ? '已开启' : '未开启'}}</text>

      </view>

    </view>



    <view class="function-card card function-card-wide" bindtap="navigateToGroupMode">

      <view class="function-wide-left">

        <view class="function-icon-wrap group">

          <view class="function-icon">

            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">

              <circle cx="7" cy="8" r="3" stroke="#FFD100" stroke-width="2"/>

              <circle cx="17" cy="8" r="3" stroke="#FFD100" stroke-width="2"/>

              <path d="M2 19C2 15.6863 4.68629 13 8 13H16C19.3137 13 22 15.6863 22 19" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/>

            </svg>

          </view>

        </view>

        <view class="function-wide-text">

          <text class="function-title">群组模式</text>

          <text class="function-desc">创建/加入群组，统一控灯</text>

        </view>

      </view>

      <text class="function-arrow">›</text>

    </view>

  </view>

</scroll-view>



<!-- 设备列表弹窗 -->

<view class="sheet-modal {{showDeviceList ? 'show' : ''}}" bindtap="closeDeviceList">

  <view class="sheet-content" catchtap="stopPropagation">

    <view class="sheet-header">

      <text class="sheet-title">选择设备</text>

      <view class="sheet-close" bindtap="closeDeviceList">×</view>

    </view>

    <view class="sheet-body">

      <view class="device-item" wx:for="{{deviceList}}" wx:key="deviceId" data-deviceid="{{item.deviceId}}" bindtap="connectDevice">

        <view class="device-info">

          <view class="device-name-row">

            <text class="device-item-name">{{item.name || item.deviceId || '未知设备'}}</text>

            <text class="device-connected-tag" wx:if="{{item.isConnectedDevice}}">已连接</text>

          </view>

          <view class="signal-bar" wx:if="{{item.RSSI}}">

            <view class="signal-fill" style="width: {{item.RSSI > -50 ? 100 : item.RSSI > -70 ? 66 : item.RSSI > -85 ? 33 : 15}}%;"></view>

          </view>

        </view>

        <view class="device-rssi">

          <text class="rssi-text">{{item.RSSI || '未知'}}</text>

        </view>

      </view>

      <view class="empty-state" wx:if="{{deviceList.length === 0 && !isScanning}}">

        <view class="empty-state-icon">📡</view>

        <text class="empty-state-title">未发现设备</text>

        <text class="empty-state-desc">请确保蓝牙已开启，设备已通电并靠近手机</text>

      </view>

      <view class="empty-state" wx:if="{{isScanning}}">

        <view class="empty-state-icon scanning-pulse">🔍</view>

        <text class="empty-state-title">正在搜索设备...</text>

        <text class="empty-state-desc">请将设备置于配对模式</text>

      </view>

    </view>

  </view>

</view>



<bottom-nav current="index"></bottom-nav>


