<page-nav-bar></page-nav-bar>
<scroll-view class="scrollarea" scroll-y>
  <view class="product-page">
    <view class="section">
      <view class="section-head">
        <text class="section-label">我的手灯</text>
        <text class="section-hint">长按可重命名</text>
      </view>
      <view class="device-list" wx:if="{{myDevices.length > 0}}">
        <view
          class="device-card connected"
          wx:for="{{myDevices}}"
          wx:key="deviceId"
          data-deviceid="{{item.deviceId}}"
          bindlongpress="onDeviceLongPress"
        >
          <view class="device-icon-wrap on">
            <view class="device-icon-light"></view>
          </view>
          <view class="device-info">
            <text class="device-name">{{item.displayName}}</text>
            <text class="device-ble-name" wx:if="{{item.customName}}">蓝牙名：{{item.bleName}}</text>
            <text class="device-id">{{item.deviceId}}</text>
            <text class="device-status connected">{{item.statusText}}</text>
          </view>
          <view class="device-action disconnect" catchtap="disconnectDevice">断开</view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-icon">💡</text>
        <text class="empty-text">暂无已连接手灯</text>
        <text class="empty-desc">点击下方「添加手灯」搜索并连接设备</text>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-label">连接过的设备</text>
        <text class="section-hint">长按可重命名</text>
      </view>
      <view class="device-list" wx:if="{{historyDevices.length > 0}}">
        <view
          class="device-card"
          wx:for="{{historyDevices}}"
          wx:key="deviceId"
          data-deviceid="{{item.deviceId}}"
          bindtap="onReconnectHistory"
          bindlongpress="onDeviceLongPress"
        >
          <view class="device-icon-wrap">
            <view class="device-icon-light dim"></view>
          </view>
          <view class="device-info">
            <text class="device-name">{{item.displayName}}</text>
            <text class="device-ble-name" wx:if="{{item.customName}}">蓝牙名：{{item.bleName}}</text>
            <text class="device-id">{{item.deviceId}}</text>
            <text class="device-status">{{item.lastConnectText}}</text>
          </view>
          <view class="device-action">连接</view>
        </view>
      </view>
      <view class="empty-card compact" wx:else>
        <text class="empty-text">暂无历史设备</text>
      </view>
    </view>

    <button class="add-device-btn" bindtap="onAddDevice">+ 添加手灯</button>
  </view>
</scroll-view>

<view class="sheet-modal {{showDeviceList ? 'show' : ''}}" bindtap="closeDeviceList">
  <view class="sheet-content" catchtap="stopPropagation">
    <view class="sheet-header">
      <text class="sheet-title">搜索手灯</text>
      <view class="sheet-close" bindtap="closeDeviceList">×</view>
    </view>
    <view class="sheet-body">
      <view class="device-item" wx:for="{{deviceList}}" wx:key="deviceId" data-deviceid="{{item.deviceId}}" bindtap="connectDevice">
        <view class="device-info-row">
          <view class="device-name-row">
            <text class="device-item-name">{{item.name || item.deviceId || '未知设备'}}</text>
            <text class="device-connected-tag" wx:if="{{item.isConnectedDevice}}">已连接</text>
          </view>
        </view>
        <view class="device-rssi">
          <text class="rssi-text">信号: {{item.RSSI || '未知'}}</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{deviceList.length === 0 && !isScanning}}">
        <view class="empty-state-icon">📡</view>
        <text class="empty-state-title">未发现设备</text>
        <text class="empty-state-desc">请确保蓝牙已开启，且手灯在附近</text>
      </view>
      <view class="empty-state" wx:if="{{isScanning}}">
        <view class="empty-state-icon scanning-pulse">🔍</view>
        <text class="empty-state-title">正在搜索设备...</text>
      </view>
    </view>
  </view>
</view>

<main-tab-bar current="product"></main-tab-bar>
