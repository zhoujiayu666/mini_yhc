page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  height: 0;
}

.product-page {
  padding: 24rpx 40rpx calc(100rpx + env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
}

.section {
  margin-bottom: 40rpx;
}

.section-label {
  display: block;
  font-size: 26rpx;
  color: #9E9E9E;
  letter-spacing: 1rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-hint {
  font-size: 22rpx;
  color: #BDBDBD;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.device-card.connected {
  border: 2rpx solid rgba(255, 209, 0, 0.35);
}

.device-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #F7F7F8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.device-icon-wrap.on {
  background: rgba(255, 209, 0, 0.15);
}

.device-icon-light {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  box-shadow: 0 0 20rpx rgba(255, 209, 0, 0.6);
}

.device-icon-light.dim {
  background: #D0D0D0;
  box-shadow: none;
}

.device-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.device-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-ble-name {
  font-size: 22rpx;
  color: #757575;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-id {
  font-size: 22rpx;
  color: #9E9E9E;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-status {
  font-size: 24rpx;
  color: #9E9E9E;
}

.device-status.connected {
  color: #C89600;
  font-weight: 500;
}

.device-action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #1A1A1A;
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.device-action.disconnect {
  background: #F7F7F8;
  color: #757575;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.empty-card.compact {
  padding: 36rpx 32rpx;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #9E9E9E;
  text-align: center;
}

.add-device-btn {
  background: linear-gradient(135deg, #FFD100 0%, #FFC400 100%);
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 8rpx;
}

.add-device-btn::after {
  border: none;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: var(--card-bg);
  border-radius: var(--radius-md);
}

.device-item:active {
  background: var(--brand-yellow-light);
}

.device-info-row {
  flex: 1;
  min-width: 0;
}

.device-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.device-item-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.device-connected-tag {
  font-size: 22rpx;
  color: var(--brand-yellow-text);
  background: var(--brand-yellow-soft);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.rssi-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
