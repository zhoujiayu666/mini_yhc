<page-nav-bar></page-nav-bar>
<scroll-view
  class="scrollarea"
  scroll-y
  scroll-top="{{scrollTop}}"
  scroll-with-animation="{{false}}"
  bindscroll="onMainScroll"
>
  <view class="container {{powerOn ? '' : 'is-powered-off'}}">
    <!-- 电源 -->
    <view class="section">
      <text class="section-label">电源</text>
      <view class="power-card">
        <view class="power-info">
          <text class="power-status">{{powerOn ? 'Power ON' : 'Power OFF'}}</text>
          <text class="power-desc">{{powerOn ? '电源已开启' : '电源已关闭'}}</text>
        </view>
        <switch
          class="power-switch"
          checked="{{powerOn}}"
          color="#34C759"
          bindchange="onPowerChange"
        />
      </view>
    </view>

    <!-- 模式 -->
    <view class="section">
      <text class="section-label">模式</text>
      <view class="mode-row">
        <view
          class="mode-item {{selectedEffect === item.id ? 'active' : ''}} {{powerOn ? '' : 'disabled'}}"
          wx:for="{{displayModes}}"
          wx:key="id"
          data-effect="{{item}}"
          bindtap="selectEffect"
        >
          <view class="mode-icon-wrap">
            <image
              class="mode-icon-img {{powerOn ? '' : 'is-dim'}}"
              src="{{selectedEffect === item.id ? item.iconActive : item.icon}}"
              mode="aspectFit"
            />
          </view>
          <text class="mode-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 颜色 -->
    <view class="section">
      <text class="section-label">颜色</text>
      <view class="color-wheel-section" bindtap="onColorAreaTap">
        <color-wheel
          hue="{{hue}}"
          saturation="{{saturation}}"
          brightness="{{brightness}}"
          showPreview="{{false}}"
          bindchange="onColorChange"
        ></color-wheel>
      </view>
    </view>

    <!-- 调节速度 -->
    <view class="section slider-section">
      <text class="slider-label">调节速度</text>
      <slider
        class="plain-slider"
        value="{{effectSpeed}}"
        min="0"
        max="100"
        step="1"
        activeColor="{{sliderTint}}"
        backgroundColor="#EBEBEB"
        block-color="#FFFFFF"
        block-size="22"
        disabled="{{!powerOn}}"
        bindchange="onSpeedChange"
      />
    </view>

    <!-- 调节亮度 -->
    <view class="section slider-section">
      <text class="slider-label">调节亮度</text>
      <slider
        class="plain-slider"
        value="{{brightness}}"
        min="0"
        max="100"
        step="1"
        activeColor="{{sliderTint}}"
        backgroundColor="#EBEBEB"
        block-color="#FFFFFF"
        block-size="22"
        disabled="{{!powerOn}}"
        bindchange="onBrightnessChange"
      />
    </view>

    <!-- 音乐律动 -->
    <view class="section rhythm-divider">
      <view class="rhythm-header">
        <text class="section-label rhythm-label">音乐律动</text>
        <view class="rhythm-help-btn" bindtap="showRhythmHelp">
          <text class="rhythm-help-q">?</text>
        </view>
      </view>
      <view class="rhythm-card">
        <view class="rhythm-mic {{isListening ? 'listening' : ''}}" bindtap="{{isListening ? 'stopRecording' : 'startRecording'}}">
          <view class="rhythm-mic-visual" wx:if="{{!isListening}}">
            <view class="rhythm-mic-head"></view>
            <view class="rhythm-mic-stem"></view>
            <view class="rhythm-mic-base"></view>
          </view>
          <view class="rhythm-stop-visual" wx:if="{{isListening}}">
            <view class="rhythm-stop-dot"></view>
            <text class="rhythm-stop-text">停止</text>
          </view>
        </view>
        <text class="rhythm-hint">{{isListening ? '正在聆听环境声音' : '点击开始音乐律动'}}</text>
        <view class="rhythm-spectrum" wx:if="{{isListening}}">
          <view
            class="rhythm-spectrum-bar"
            wx:for="{{spectrumBars}}"
            wx:key="index"
            style="transform: scaleY({{item}});"
          ></view>
        </view>
      </view>
    </view>

    <view class="section slider-section">
      <view class="rhythm-sens-header">
        <text class="slider-label">灵敏度</text>
        <text class="rhythm-sens-value">{{sensitivity}}%</text>
      </view>
      <view class="rhythm-presets">
        <view class="rhythm-preset {{sensitivity <= 50 ? 'active' : ''}}" data-value="40" bindtap="setSensitivityPreset">低</view>
        <view class="rhythm-preset {{sensitivity > 50 && sensitivity <= 120 ? 'active' : ''}}" data-value="100" bindtap="setSensitivityPreset">中</view>
        <view class="rhythm-preset {{sensitivity > 120 ? 'active' : ''}}" data-value="160" bindtap="setSensitivityPreset">高</view>
      </view>
      <slider
        class="plain-slider"
        value="{{sensitivity}}"
        min="0"
        max="200"
        step="1"
        activeColor="#FFD100"
        backgroundColor="#EBEBEB"
        block-color="#FFD100"
        block-size="22"
        bindchange="onSensitivityChange"
      />
    </view>
  </view>
</scroll-view>

<view class="help-modal-mask" wx:if="{{showHelpPopup}}" bindtap="closeRhythmHelp">
  <view class="help-modal" catchtap="stopRhythmPropagation">
    <view class="help-title">使用说明</view>
    <view class="help-content">
      <text>(1)小程序通过蓝牙连接和控制您的荧光棒或发光手环，请在使用过程中确保蓝牙保持打开状态；</text>
      <text>(2)出现设备无法控制状态时，请重新启动小程序或者设备；</text>
      <text>(3)设备低电状态可能出现颜色显示不准，请保持设备电量充足。</text>
      <text class="help-version">{{helpVersionLine}}</text>
    </view>
    <view class="help-confirm" bindtap="closeRhythmHelp">知道了</view>
  </view>
</view>

<view class="sheet-modal {{showDeviceList ? 'show' : ''}}" bindtap="closeDeviceList">
  <view class="sheet-content" catchtap="stopPropagation">
    <view class="sheet-header">
      <text class="sheet-title">选择设备</text>
      <view class="sheet-close" bindtap="closeDeviceList">×</view>
    </view>
    <view class="sheet-body">
      <view class="device-item" wx:for="{{deviceList}}" wx:key="deviceId" data-deviceid="{{item.deviceId}}" bindtap="connectDevice">
        <view class="device-info">
          <view class="device-name-row">
            <text class="device-item-name">{{item.name || item.deviceId || '未知设备'}}</text>
            <text class="device-connected-tag" wx:if="{{item.isConnectedDevice}}">已连接</text>
          </view>
        </view>
        <view class="device-rssi">
          <text class="rssi-text">信号: {{item.RSSI || '未知'}}</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{deviceList.length === 0 && !isScanning}}">
        <view class="empty-state-icon">📡</view>
        <text class="empty-state-title">未发现设备</text>
        <text class="empty-state-desc">请确保蓝牙已开启，且设备在附近</text>
      </view>
      <view class="empty-state" wx:if="{{isScanning}}">
        <view class="empty-state-icon scanning-pulse">🔍</view>
        <text class="empty-state-title">正在搜索设备...</text>
      </view>
    </view>
  </view>
</view>

<main-tab-bar current="control"></main-tab-bar>
