page{background:#f6f6f6;color:#20232a}.redeem-page{padding:28rpx 28rpx calc(200rpx + env(safe-area-inset-bottom))}.page-title{display:block;font-size:40rpx;font-weight:700;margin:0 0 30rpx}.card{padding:30rpx;background:#fff;border-radius:20rpx;margin-bottom:24rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin-bottom:24rpx}.row:last-child{margin-bottom:0}.product{display:flex;gap:26rpx;align-items:center}.product image{width:150rpx;height:150rpx;flex-shrink:0;border-radius:12rpx;background:#eee}.product>view{flex:1;min-width:0}.product-title{display:block;font-size:31rpx;font-weight:600;line-height:1.6;margin-bottom:16rpx;word-break:break-all}.gold{color:#89691d;font-size:30rpx;font-weight:600}.muted{display:block;font-size:26rpx;color:#868c96;line-height:1.7;word-break:break-all}.strong{font-weight:600}.address-name{display:block;font-size:28rpx;margin:20rpx 0 12rpx}.stepper{display:flex;align-items:center;border:1px solid #eee;border-radius:10rpx;overflow:hidden}.stepper button{width:64rpx;height:62rpx;padding:0;line-height:60rpx;border-radius:0;background:#f6f6f6;font-size:32rpx}.stepper text{min-width:64rpx;text-align:center;font-size:28rpx}.stepper button::after,button::after{border:0}.fixed-action{position:fixed;left:0;bottom:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;gap:24rpx;background:#fff;border-top:1px solid #eee;padding:22rpx 30rpx calc(22rpx + env(safe-area-inset-bottom))}.fixed-action>view{flex:1}.fixed-action .primary{margin:0;width:330rpx;flex-shrink:0}.total{display:block;font-weight:600;font-size:34rpx;color:#89691d}.primary{border-radius:999rpx;font-size:30rpx;line-height:88rpx;padding:0 30rpx;background:#f5d76e;color:#27231b;font-weight:600}.primary[disabled]{background:#e8e8e8;color:#999}.secondary{border-radius:999rpx;background:#fff;border:1px solid #ddd;color:#555;font-size:27rpx;margin-top:20rpx}.empty{padding:130rpx 20rpx;text-align:center;color:#87909b;font-size: