{
  "pages": [
    "pages/home/home",
    "pages/all-products/all-products",
    "pages/member/member",
    "pages/mine/mine",
    "pages/home-editor/home-editor",
    "pages/control/control",
    "pages/login/login",
    "pages/room/room",
    "pages/product/product",
    "pages/show/show",
    "pages/around/around",
    "pages/product-detail/product-detail",
    "pages/home-product-detail/home-product-detail",
    "pages/home-content-detail/home-content-detail",
    "pages/member-content/member-content",
    "pages/checkout/checkout",
    "pages/orders/orders",
    "pages/order-detail/order-detail",
    "pages/address-list/address-list",
    "pages/address-edit/address-edit",
    "pages/user-agreement/user-agreement",
    "pages/software/software",
    "pages/connect-guide/connect-guide",
    "pages/index/index",
    "pages/group-mode/group-mode",
    "pages/color-control/color-control",
    "pages/music-rhythm/music-rhythm",
    "pages/settings/settings",
    "pages/redemption-checkout/redemption-checkout",
    "pages/redemption-orders/redemption-orders",
    "pages/redemption-order/redemption-order"
  ],
  "window": {
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom",
    "backgroundColor": "#FFFFFF",
    "backgroundTextStyle": "dark"
  },
  "cloud": true,
  "style": "v2",
  "renderer": "skyline",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "tagNameStyleIsolation": "legacy",
      "disableABTest": true,
      "sdkVersionBegin": "3.0.0",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "tabBar": {
    "custom": true,
    "color": "#9E9E9E",
    "selectedColor": "#1A1A1A",
    "backgroundColor": "#FFFFFF",
    "list": [
      { "pagePath": "pages/home/home", "text": "首页" },
      { "pagePath": "pages/all-products/all-products", "text": "全部商品" },
      { "pagePath": "pages/member/member", "text": "会员中心" },
      { "pagePath": "pages/mine/mine", "text": "个人中心" }
    ]
  },
  "usingComponents": {
    "main-tab-bar": "/components/main-tab-bar/main-tab-bar",
    "page-nav-bar": "/components/page-nav-bar/page-nav-bar"
  },
  "permission": {
    "scope.bluetooth": {
      "desc": "用于连接和控制灯光设备"
    },
    "scope.userLocation": {
      "desc": "用于在部分安卓手机上搜索附近蓝牙灯光设备"
    },
    "scope.record": {
      "desc": "用于音乐律动功能，分析环境音频"
    }
  }
}
