/* components/color-wheel/color-wheel.wxss */

.color-wheel-wrapper {

  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;

  width: 100%;

  box-sizing: border-box;

}



.color-wheel-inner {

  position: relative;

  width: 506rpx;

  height: 506rpx;

  margin: 0 auto;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

}



.color-wheel-container {

  position: relative;

  width: 506rpx;

  height: 506rpx;

  border-radius: 50%;

  touch-action: none;

  display: flex;

  align-items: center;

  justify-content: center;

  background-color: rgba(0, 0, 0, 0.04);

}



.color-wheel-ring {

  position: absolute;

  width: 100%;

  height: 100%;

  border-radius: 50%;

  background:
    radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 6.6%),
    conic-gradient(
      from 0deg,
      #ff0000 0deg,
      #ffff00 60deg,
      #00ff00 120deg,
      #00ffff 180deg,
      #0000ff 240deg,
      #ff00ff 300deg,
      #ff0000 360deg
    );
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);

}



.color-wheel-center {

  position: absolute;

  width: 22rpx;

  height: 22rpx;

  border-radius: 50%;

  background-color: #FFFFFF;

  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);

  z-index: 1;

}



.color-selector {

  position: absolute;

  width: 40rpx;

  height: 40rpx;

  transform: translate(-50%, -50%);

  pointer-events: none;

  z-index: 10;

}



.selector-dot {

  width: 40rpx;

  height: 40rpx;

  border-radius: 50%;

  border: 4rpx solid #FFFFFF;

  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  background-color: transparent;

}



.color-preview {

  position: absolute;

  right: 0;

  bottom: 0;

  width: 80rpx;

  height: 80rpx;

  border-radius: 50%;

  border: 4rpx solid #FFFFFF;

  box-shadow:

    0 6rpx 20rpx rgba(0, 0, 0, 0.12),

    0 0 24rpx rgba(255, 209, 0, 0.25);

  flex-shrink: 0;

  transform: translate(20rpx, 20rpx);

}


