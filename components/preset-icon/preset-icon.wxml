<view class="preset-icon">
  <!-- 黑场 -->
  <block wx:if="{{type === 'black'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="8" fill="{{fill}}"/>
    </svg>
  </block>

  <!-- 常亮 ON -->
  <block wx:elif="{{type === 'white'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="5" stroke="{{stroke}}" stroke-width="2.2" fill="{{active ? '#F5F5F5' : 'none'}}"/>
      <path d="M12 3V5M12 19V21M3 12H5M19 12H21M5.6 5.6L7 7M17 17L18.4 18.4M5.6 18.4L7 17M17 7L18.4 5.6" stroke="{{stroke}}" stroke-width="2.2" stroke-linecap="round"/>
    </svg>
  </block>

  <!-- 随机 -->
  <block wx:elif="{{type === 'random'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <path d="M4 8H14M14 8L11 5M14 8L11 11" stroke="{{stroke}}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 16H10M10 16L13 13M10 16L13 19" stroke="{{stroke}}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </block>

  <!-- 快闪 Flash -->
  <block wx:elif="{{type === 'flash'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <path d="M13 3L6 14H11L10 21L18 10H13L13 3Z" stroke="{{stroke}}" stroke-width="2.2" stroke-linejoin="round" fill="{{active ? '#F0F0F0' : 'none'}}"/>
    </svg>
  </block>

  <!-- 眨眼 -->
  <block wx:elif="{{type === 'blink'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <path d="M3 12C5.5 8 8.5 6 12 6C15.5 6 18.5 8 21 12C18.5 16 15.5 18 12 18C8.5 18 5.5 16 3 12Z" stroke="{{stroke}}" stroke-width="2.2" stroke-linejoin="round"/>
      <circle cx="12" cy="12" r="2.5" fill="{{fill}}"/>
    </svg>
  </block>

  <!-- 呼吸 Dimming -->
  <block wx:elif="{{type === 'breath'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <path d="M4 14C7 10 9 10 12 14C15 18 17 18 20 14" stroke="{{stroke}}" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M4 10C7 14 9 14 12 10C15 6 17 6 20 10" stroke="{{accent}}" stroke-width="2.2" stroke-linecap="round"/>
    </svg>
  </block>

  <!-- 聚会 Party -->
  <block wx:elif="{{type === 'party'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <path d="M12 4L13.5 9.5L19 11L13.5 12.5L12 18L10.5 12.5L5 11L10.5 9.5L12 4Z" stroke="{{stroke}}" stroke-width="2.2" stroke-linejoin="round" fill="{{active ? '#F0F0F0' : 'none'}}"/>
      <circle cx="18" cy="6" r="1.4" fill="{{fill}}"/>
      <circle cx="6" cy="17" r="1.2" fill="{{fill}}"/>
    </svg>
  </block>

  <!-- 彩虹 Rainbow -->
  <block wx:elif="{{type === 'rainbow'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <path d="M5 16C5 11 8 8 12 8C16 8 19 11 19 16" stroke="{{stroke}}" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M8 16C8 12.5 9.8 11 12 11C14.2 11 16 12.5 16 16" stroke="{{accent}}" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M11 16C11 14.3 11.6 13.5 12 13.5C12.4 13.5 13 14.3 13 16" stroke="{{fill}}" stroke-width="2.2" stroke-linecap="round"/>
    </svg>
  </block>

  <!-- 星空 -->
  <block wx:elif="{{type === 'star'}}">
    <svg width="{{size}}" height="{{size}}" viewBox="0 0 24 24" fill="none">
      <path d="M12 5L13.4 9.6L18 11L13.4 12.4L12 17L10.6 12.4L6 11L10.6 9.6L12 5Z" stroke="{{stroke}}" stroke-width="2.2" stroke-linejoin="round" fill="{{active ? '#F0F0F0' : 'none'}}"/>
      <circle cx="6" cy="7" r="1" fill="{{fill}}"/>
      <circle cx="18" cy="8" r="0.8" fill="{{fill}}"/>
      <circle cx="17" cy="17" r="0.9" fill="{{fill}}"/>
    </svg>
  </block>
</view>
