.sheet-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99999;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.72);
}

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 52vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.18);
  animation: sheet-up 0.25s ease-out;
}

.sheet-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  z-index: 2;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f7f7f8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-close-hover {
  opacity: 0.72;
}

.sheet-close-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #757575;
}

@keyframes sheet-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e8e8e8;
  margin: 8rpx auto 28rpx;
}

.sheet-header {
  margin-bottom: 36rpx;
}

.sheet-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.sheet-subtitle {
  display: block;
  font-size: 26rpx;
  color: #9e9e9e;
  line-height: 1.5;
}

.wx-login-wrap {
  position: relative;
  height: 92rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ffd100 0%, #ffc400 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-login-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.wx-login-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
}

.wx-login-cover::after {
  border: none;
}

.other-login-link {
  display: block;
  text-align: center;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #757575;
}

.manual-block {
  margin-top: 28rpx;
}

.input-row {
  display: flex;
  align-items: center;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  height: 92rpx;
  box-sizing: border-box;
}

.input-prefix {
  font-size: 30rpx;
  color: #1a1a1a;
  margin-right: 16rpx;
}

.phone-input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
}

.manual-btn {
  background: linear-gradient(135deg, #ffd100 0%, #ffc400 100%);
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.manual-btn::after,
.skip-btn::after {
  border: none;
}

.agreement-block {
  margin-top: 36rpx;
  padding-top: 8rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
}

.agree-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #bdbdbd;
  margin-right: 12rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.agree-check.checked {
  border-color: #ffc400;
  background: #ffc400;
  position: relative;
}

.agree-check.checked::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 4rpx;
  width: 10rpx;
  height: 16rpx;
  border: 2rpx solid #1a1a1a;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}

.agreement-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.65;
  color: #616161;
  word-break: break-all;
}

.agree-plain {
  color: #616161;
}

.agree-link {
  color: #2f6bff;
}

.agree-tip {
  display: block;
  margin-top: 12rpx;
  padding-left: 44rpx;
  font-size: 22rpx;
  color: #9e9e9e;
  line-height: 1.55;
}

.skip-btn {
  margin-top: 20rpx;
  background: transparent;
  color: #9e9e9e;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
}
